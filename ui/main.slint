import { ScrollView } from "std-widgets.slint";
import {
    Ink,
    Type,
    NavItem,
    FillBtn,
    TextBtn,
    GlyphBtn,
    Segments,
    SegmentBtn,
    Tab,
    Switch,
    ToggleRow,
    Field,
    MenuSelect,
    Pill,
    DebugRow,
    SettingsSection,
    RowRule,
    CheckChip,
} from "theme.slint";

export { Ink }

export struct ThemeItem {
    name: string,
    display_name: string,
    comment: string,
    cursor_type: string,
    is_active: bool,
    is_deletable: bool,
    is_user: bool,
    path: string,
    preview_default: image,
    preview_pointer: image,
    preview_wait: image,
    preview_text: image,
    has_preview: bool,
}

export struct StudioRole {
    id: string,
    label: string,
    hint: string,
    group: string,
    first: bool,
    assigned: bool,
    frames: int,
    thumb: image,
}

export struct StudioSize {
    px: int,
    on: bool,
}

component PreviewStrip inherits Rectangle {
    in property <image> a;
    in property <image> b;
    in property <image> c;
    in property <image> d;
    in property <bool> has-preview;
    in property <length> glyph: 24px;

    border-radius: 12px;
    background: Ink.surface;
    if root.has-preview: HorizontalLayout {
        alignment: center;
        spacing: root.glyph / 2;
        for frame in [root.a, root.b, root.c, root.d]: VerticalLayout {
            alignment: center;
            Image {
                width: root.glyph;
                height: root.glyph;
                source: frame;
                image-fit: contain;
            }
        }
    }
    if !root.has-preview: Text {
        text: "No preview";
        font-size: Type.small;
        color: Ink.faint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    title: "Mouse Me";
    min-width: 1080px;
    min-height: 700px;
    preferred-width: 1240px;
    preferred-height: 800px;
    background: Ink.ground;
    default-font-family: Type.family;
    default-font-size: 14px;
    default-font-weight: 400;

    in-out property <int> page: 0;
    in-out property <int> appearance: 0;
    init => { Ink.mode = root.appearance; }
    changed appearance => { Ink.mode = root.appearance; }
    in-out property <string> active_theme_name: "";
    in-out property <string> active_display_name: "";
    in-out property <string> active_meta: "";
    in-out property <image> active_preview_default;
    in-out property <image> active_preview_pointer;
    in-out property <image> active_preview_text;
    in-out property <image> active_preview_wait;
    in-out property <bool> active_has_preview: false;
    in-out property <int> active_size: 24;
    in-out property <[ThemeItem]> themes: [];
    in-out property <string> search_query: "";
    in-out property <string> library_filter: "all";
    in-out property <string> library_type: "all";
    in-out property <int> theme_count: 0;
    in-out property <int> count_all: 0;
    in-out property <int> count_user: 0;
    in-out property <int> count_system: 0;
    in-out property <length> library_viewport_y: 0px;
    in-out property <length> library_visible_height: 0px;
    in-out property <string> status_message: "";
    in-out property <bool> status_is_error: false;
    in-out property <bool> is_loading: false;
    in-out property <bool> checking_update: false;

    in-out property <bool> apply_hyprland: true;
    in-out property <bool> apply_gsettings: true;
    in-out property <bool> apply_gtk: true;
    in-out property <bool> apply_qt: true;
    in-out property <bool> apply_environment: true;
    in-out property <bool> apply_xresources: true;
    in-out property <bool> apply_default_index: true;
    in-out property <bool> apply_flatpak: true;
    in-out property <bool> auto_apply_on_import: false;
    in-out property <bool> apply_size_immediately: true;
    in-out property <bool> show_user_themes: true;
    in-out property <bool> show_system_themes: true;
    in-out property <bool> enable_hyprcursor: true;
    in-out property <bool> hide_on_key_press: false;
    in-out property <bool> hide_on_touch: true;
    in-out property <bool> no_hardware_cursors: false;
    in-out property <int> inactive_timeout: 0;
    in-out property <bool> auto_update: false;
    in-out property <int> auto_update_when: 0;

    in-out property <string> studio_name: "Custom Pointer";
    in-out property <string> studio_comment: "";
    in-out property <[StudioRole]> studio_roles: [];
    in-out property <string> studio_selected_role: "left_ptr";
    in-out property <string> studio_role_label: "Default";
    in-out property <string> studio_role_hint: "";
    in-out property <[image]> studio_frames: [];
    in-out property <int> studio_frame_index: 0;
    in-out property <int> studio_edge: 32;
    in-out property <int> studio_hotspot_x: 0;
    in-out property <int> studio_hotspot_y: 0;
    in-out property <int> studio_delay: 80;
    in-out property <[StudioSize]> studio_sizes: [];
    in-out property <bool> studio_fill_missing: true;
    in-out property <int> studio_assigned: 0;
    in-out property <int> studio_canvas_bg: 0;
    in-out property <string> studio_coverage_note: "";
    in-out property <string> studio_folder: "";
    in-out property <[string]> studio_theme_choices: [];
    in-out property <int> studio_open_index: 0;
    in-out property <string> import_note: "";
    in-out property <string> app_version: "0.1.0";
    in-out property <string> update_note: "";
    in-out property <bool> update_available: false;
    in-out property <string> update_tag: "";

    in-out property <bool> auth_signed_in: false;
    in-out property <bool> auth_creating: false;
    in-out property <bool> auth_busy: false;
    in-out property <string> auth_name: "";
    in-out property <string> auth_username: "";
    in-out property <string> auth_email: "";
    in-out property <string> auth_password: "";
    in-out property <string> auth_confirm: "";
    in-out property <string> auth_session_email: "";
    in-out property <string> auth_session_name: "";
    in-out property <string> auth_session_username: "";
    in-out property <string> auth_joined: "";
    in-out property <string> auth_published_label: "";
    in-out property <image> auth_avatar;
    in-out property <bool> auth_has_avatar: false;
    in-out property <string> auth_error: "";
    in-out property <string> device_os: "";
    in-out property <string> device_desktop: "";
    in-out property <string> device_session: "";
    in-out property <string> device_kernel: "";
    in-out property <string> device_cursor: "";
    in-out property <string> device_gtk: "";
    in-out property <string> device_qt: "";
    in-out property <string> device_env: "";

    callback apply_theme(string, int);
    callback import_theme_dialog();
    callback import_folder_dialog();
    callback import_dropped(data-transfer);
    callback studio_files_dropped(data-transfer);
    callback delete_theme(string);
    callback open_in_studio(string);
    callback refresh_themes();
    callback search_changed(string);
    callback size_changed(int);
    callback page_changed(int);
    callback filter_changed();
    callback settings_changed();
    callback hypr_prefs_changed();
    callback studio_pick_frames(bool);
    callback studio_select_role(string);
    callback studio_select_frame(int);
    callback studio_remove_frame();
    callback studio_move_frame(int);
    callback studio_clear_role();
    callback studio_fill_empty();
    callback studio_set_hotspot(float, float);
    callback studio_nudge_hotspot(int, int);
    callback studio_auto_hotspot();
    callback studio_set_delay(int);
    callback studio_toggle_size(int);
    callback studio_meta_changed();
    callback studio_open_theme(int);
    callback studio_new_project();
    callback studio_export();
    callback open_themes_folder();
    callback check_for_update();
    callback apply_update();
    callback dismiss_update();
    callback copy_device_info();
    callback refresh_device_info();
    callback open_support();
    callback open_x();
    callback open_contribute();
    callback sign_in();
    callback create_account();
    callback sign_out();
    callback open_forgot_password();
    callback open_account_page();

    function go(p: int) {
        root.page = p;
        root.page_changed(p);
    }

    function submit-auth() {
        if root.auth_creating {
            root.create_account();
        } else {
            root.sign_in();
        }
    }

    property <bool> jump-to-account: false;
    property <string> account-label: !root.auth_signed_in ? "Sign in"
        : (root.auth_session_name != "" ? root.auth_session_name : (root.auth_session_username != "" ? root.auth_session_username : root.auth_session_email));
    property <int> targets-on: (root.apply_hyprland ? 1 : 0) + (root.apply_gsettings ? 1 : 0) + (root.apply_gtk ? 1 : 0)
        + (root.apply_qt ? 1 : 0) + (root.apply_environment ? 1 : 0) + (root.apply_xresources ? 1 : 0)
        + (root.apply_default_index ? 1 : 0) + (root.apply_flatpak ? 1 : 0);

    HorizontalLayout {
        // Sidebar: the mark, three destinations, then the account and version.
        VerticalLayout {
            width: 220px;
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 14px;
            spacing: 2px;

            HorizontalLayout {
                height: 64px;
                padding-left: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 7px;
                        clip: true;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: @image-url("../assets/mouse-me.png");
                            image-fit: cover;
                        }
                    }
                }
                Text {
                    text: "Mouse Me";
                    font-size: 15px;
                    font-weight: 600;
                    color: Ink.text;
                    vertical-alignment: center;
                }
            }

            Rectangle { height: 10px; }

            NavItem {
                label: "Library";
                icon: @image-url("../assets/icons/house.svg");
                meta: root.count_all > 0 ? root.count_all : "";
                active: root.page == 0;
                clicked => { root.go(0); }
            }
            NavItem {
                label: "Studio";
                icon: @image-url("../assets/icons/avocado.svg");
                meta: root.studio_assigned + "/" + root.studio_roles.length;
                active: root.page == 1;
                clicked => { root.go(1); }
            }
            NavItem {
                label: "Settings";
                icon: @image-url("../assets/icons/gear.svg");
                active: root.page == 2;
                clicked => { root.go(2); }
            }

            Rectangle { vertical-stretch: 1; }

            if root.update_available: Rectangle {
                height: 58px;
                border-radius: 12px;
                background: update-touch.has-hover ? Ink.raised : Ink.surface;
                VerticalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    spacing: 2px;
                    Text {
                        text: root.update_tag + " is ready";
                        font-size: 13px;
                        font-weight: 500;
                        color: Ink.text;
                    }
                    Text {
                        text: "Install the update";
                        font-size: Type.small;
                        color: Ink.muted;
                    }
                }
                update-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.apply_update(); }
                }
            }

            Rectangle { height: 8px; }

            Rectangle {
                height: 44px;
                border-radius: 10px;
                background: account-touch.has-hover ? Ink.hover : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            clip: true;
                            background: Ink.raised;
                            if root.auth_signed_in && root.auth_has_avatar: Image {
                                width: 100%;
                                height: 100%;
                                source: root.auth_avatar;
                                image-fit: cover;
                            }
                            if !(root.auth_signed_in && root.auth_has_avatar): Image {
                                x: 5px;
                                y: 5px;
                                width: 14px;
                                height: 14px;
                                source: @image-url("../assets/icons/user.svg");
                                colorize: Ink.muted;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.account-label;
                            font-size: 13px;
                            font-weight: 500;
                            color: Ink.text;
                            overflow: elide;
                        }
                        Text {
                            text: "Version " + root.app_version;
                            font-size: Type.small;
                            color: Ink.faint;
                        }
                    }
                }
                account-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.jump-to-account = true;
                        root.go(2);
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Ink.rule;
        }

        VerticalLayout {
            horizontal-stretch: 1;

            // Top bar: where you are, what just happened, and the pointer in use.
            HorizontalLayout {
                height: 64px;
                padding-left: 29px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.page == 0 ? "Library" : (root.page == 1 ? "Studio" : "Settings");
                        font-size: Type.body;
                        font-weight: 500;
                        color: root.page == 1 ? Ink.muted : Ink.text;
                        vertical-alignment: center;
                    }
                    if root.page == 1: Text {
                        text: "/";
                        color: Ink.faint;
                        vertical-alignment: center;
                    }
                    if root.page == 1: Text {
                        text: root.studio_name != "" ? root.studio_name : "Untitled";
                        font-size: Type.body;
                        font-weight: 500;
                        color: Ink.text;
                        vertical-alignment: center;
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.status_message;
                    font-size: 13px;
                    color: root.status_is_error ? Ink.negative : Ink.muted;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                }

                // Exactly as wide as Studio's inspector, rule included, so
                // the divider runs on into the inspector's edge.
                HorizontalLayout {
                    width: 261px;
                Rectangle {
                    width: 1px;
                    background: Ink.rule;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: scope-touch.has-hover ? Ink.hover : transparent;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 20px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 8px;
                                background: Ink.surface;
                                if root.active_has_preview: Image {
                                    x: 6px;
                                    y: 6px;
                                    width: 20px;
                                    height: 20px;
                                    source: root.active_preview_default;
                                    image-fit: contain;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.active_display_name != "" ? root.active_display_name : "No pointer set";
                                font-size: 13px;
                                font-weight: 500;
                                color: Ink.text;
                                overflow: elide;
                            }
                            Text {
                                text: root.active_display_name != "" ? "In use, " + root.active_size + " px" : "Pick one in Library";
                                font-size: Type.small;
                                color: root.active_display_name != "" ? Ink.accent : Ink.faint;
                            }
                        }
                    }
                    scope-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.go(0); }
                    }
                }
                }
            }

            RowRule { }

            if root.page == 0: library-drop := DropArea {
                vertical-stretch: 1;
                can-drop(event) => { return DragAction.copy; }
                dropped(event) => {
                    root.import_dropped(event.data);
                    return DragAction.copy;
                }

                VerticalLayout {
                    padding: 29px;
                    padding-top: 24px;
                    padding-bottom: 0px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Library";
                            font-size: Type.title;
                            font-weight: 600;
                            color: Ink.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        FillBtn {
                            label: "Add folder";
                            quiet: true;
                            clicked => { root.import_folder_dialog(); }
                        }
                        FillBtn {
                            label: "Add pack";
                            clicked => { root.import_theme_dialog(); }
                        }
                    }

                    // The pointer in use, with the size it is drawn at.
                    Rectangle {
                        height: 112px;
                        border-radius: 20px;
                        background: Ink.surface;
                        HorizontalLayout {
                            padding: 20px;
                            padding-left: 22px;
                            spacing: 22px;

                            PreviewStrip {
                                width: 232px;
                                background: Ink.ground;
                                glyph: 32px;
                                a: root.active_preview_default;
                                b: root.active_preview_pointer;
                                c: root.active_preview_text;
                                d: root.active_preview_wait;
                                has-preview: root.active_has_preview;
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text {
                                    text: "In use";
                                    font-size: Type.small;
                                    color: Ink.accent;
                                }
                                Text {
                                    text: root.active_display_name != "" ? root.active_display_name : "—";
                                    font-size: Type.figure;
                                    font-weight: 600;
                                    color: Ink.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.active_display_name != ""
                                        ? root.active_meta + ", written to " + root.targets-on + " of 8 places"
                                        : "Apply a pack below and it is written everywhere at once.";
                                    font-size: 13px;
                                    color: Ink.muted;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: root.apply_size_immediately ? "Size" : "Size, used on the next apply";
                                    font-size: Type.small;
                                    color: Ink.faint;
                                }
                                Segments {
                                    for px in [16, 24, 32, 48, 64]: SegmentBtn {
                                        label: px;
                                        active: root.active_size == px;
                                        clicked => { root.size_changed(px); }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        HorizontalLayout {
                            spacing: 24px;
                            Tab {
                                label: "All";
                                count: root.count_all;
                                active: root.library_filter == "all";
                                clicked => { root.library_filter = "all"; root.filter_changed(); }
                            }
                            Tab {
                                label: "Yours";
                                count: root.count_user;
                                active: root.library_filter == "user";
                                clicked => { root.library_filter = "user"; root.filter_changed(); }
                            }
                            Tab {
                                label: "System";
                                count: root.count_system;
                                active: root.library_filter == "system";
                                clicked => { root.library_filter = "system"; root.filter_changed(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        RowRule { }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            width: 280px;
                            placeholder: "Search packs";
                            value: root.search_query;
                            edited(t) => { root.search_changed(t); }
                        }
                        Segments {
                            SegmentBtn {
                                label: "Any format";
                                active: root.library_type == "all";
                                clicked => { root.library_type = "all"; root.filter_changed(); }
                            }
                            SegmentBtn {
                                label: "XCursor";
                                active: root.library_type == "xcursor";
                                clicked => { root.library_type = "xcursor"; root.filter_changed(); }
                            }
                            SegmentBtn {
                                label: "Hyprcursor";
                                active: root.library_type == "hyprcursor";
                                clicked => { root.library_type = "hyprcursor"; root.filter_changed(); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.is_loading ? "Scanning…" : (root.theme_count == 1 ? "1 pack" : root.theme_count + " packs");
                            font-size: 13px;
                            color: Ink.faint;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            GlyphBtn {
                                glyph: "↻";
                                enabled: !root.is_loading;
                                clicked => { root.refresh_themes(); }
                            }
                        }
                    }

                    // The list: rules and alignment, no cards.
                    VerticalLayout {
                        vertical-stretch: 1;

                        HorizontalLayout {
                            height: 28px;
                            spacing: 20px;
                            padding-right: 12px;
                            Text { width: 168px; text: "Preview"; font-size: Type.small; color: Ink.faint; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: "Pack"; font-size: Type.small; color: Ink.faint; vertical-alignment: center; }
                            Text { width: 84px; text: "Format"; font-size: Type.small; color: Ink.faint; vertical-alignment: center; }
                            Text { width: 64px; text: "Source"; font-size: Type.small; color: Ink.faint; vertical-alignment: center; }
                            Rectangle { width: 132px; }
                        }

                        if library-drop.has-drag: Rectangle {
                            vertical-stretch: 1;
                            border-radius: 16px;
                            background: Ink.surface;
                            border-width: 1px;
                            border-color: Ink.faint;
                            Text {
                                text: "Drop to install. Archives (zip, tar.gz, tar.xz) and theme folders both work.";
                                font-size: Type.body;
                                color: Ink.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if !library-drop.has-drag && root.theme_count == 0: VerticalLayout {
                            vertical-stretch: 1;
                            RowRule { }
                            HorizontalLayout {
                                height: 72px;
                                spacing: 12px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.is_loading ? "Scanning your icon folders…"
                                        : (root.search_query != "" ? "No packs match \"" + root.search_query + "\"."
                                        : "No packs here. Add an archive or a folder, drop one on this page, or make your own in Studio.");
                                    font-size: Type.body;
                                    color: Ink.muted;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                if !root.is_loading && root.search_query == "": VerticalLayout {
                                    alignment: center;
                                    FillBtn {
                                        label: "Open Studio";
                                        quiet: true;
                                        clicked => { root.go(1); }
                                    }
                                }
                            }
                            RowRule { }
                            Rectangle { vertical-stretch: 1; }
                        }

                        if !library-drop.has-drag && root.theme_count > 0: ScrollView {
                            vertical-stretch: 1;
                            viewport-y <=> root.library_viewport_y;
                            changed visible-height => {
                                root.library_visible_height = self.visible-height;
                            }
                            VerticalLayout {
                                for item in root.themes: Rectangle {
                                    height: 73px;
                                    background: row-touch.has-hover ? Ink.hover : transparent;

                                    Rectangle {
                                        y: 0;
                                        height: 1px;
                                        background: Ink.row-rule;
                                    }

                                    row-touch := TouchArea { }

                                    HorizontalLayout {
                                        y: 1px;
                                        height: 72px;
                                        spacing: 20px;
                                        padding-right: 12px;

                                        PreviewStrip {
                                            width: 168px;
                                            height: 52px;
                                            y: 10px;
                                            glyph: 22px;
                                            a: item.preview_default;
                                            b: item.preview_pointer;
                                            c: item.preview_text;
                                            d: item.preview_wait;
                                            has-preview: item.has_preview;
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: item.display_name;
                                                font-size: Type.body;
                                                font-weight: 500;
                                                color: Ink.text;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: item.comment != "" ? item.comment : item.path;
                                                font-size: 13px;
                                                color: Ink.muted;
                                                overflow: elide;
                                            }
                                        }

                                        Text {
                                            width: 84px;
                                            text: item.cursor_type;
                                            font-size: 13px;
                                            color: Ink.muted;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            width: 64px;
                                            text: item.is_user ? "Yours" : "System";
                                            font-size: 13px;
                                            color: Ink.muted;
                                            vertical-alignment: center;
                                        }

                                        HorizontalLayout {
                                            width: 132px;
                                            spacing: 6px;
                                            alignment: end;
                                            if item.is_active: VerticalLayout {
                                                alignment: center;
                                                Pill {
                                                    label: "In use";
                                                    fill: Ink.accent-bg;
                                                    ink: Ink.accent;
                                                }
                                            }
                                            if !item.is_active: VerticalLayout {
                                                alignment: center;
                                                FillBtn {
                                                    height: 32px;
                                                    label: "Apply";
                                                    quiet: true;
                                                    clicked => { root.apply_theme(item.name, root.active_size); }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                more := Rectangle {
                                                    width: 32px;
                                                    height: 32px;
                                                    border-radius: 16px;
                                                    background: more-touch.has-hover ? Ink.raised : transparent;
                                                    Text {
                                                        width: 100%;
                                                        height: 100%;
                                                        text: "⋯";
                                                        font-size: 16px;
                                                        color: Ink.muted;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    more-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { row-menu.show(); }
                                                    }
                                                    row-menu := PopupWindow {
                                                        x: parent.width - 180px;
                                                        y: parent.height + 4px;
                                                        width: 180px;
                                                        Rectangle {
                                                            background: Ink.dark ? Ink.raised : Ink.ground;
                                                            border-radius: 10px;
                                                            border-width: Ink.dark ? 0px : 1px;
                                                            border-color: Ink.rule;
                                                            drop-shadow-blur: 16px;
                                                            drop-shadow-color: Ink.shadow;
                                                            VerticalLayout {
                                                                padding: 4px;
                                                                Rectangle {
                                                                    height: 32px;
                                                                    border-radius: 7px;
                                                                    background: open-touch.has-hover ? Ink.overlay-hover : transparent;
                                                                    opacity: item.cursor_type == "XCursor" ? 1 : 0.4;
                                                                    Text {
                                                                        x: 10px;
                                                                        height: 100%;
                                                                        text: "Open in Studio";
                                                                        font-size: 13px;
                                                                        color: Ink.text;
                                                                        vertical-alignment: center;
                                                                    }
                                                                    open-touch := TouchArea {
                                                                        mouse-cursor: pointer;
                                                                        clicked => {
                                                                            if item.cursor_type == "XCursor" {
                                                                                root.open_in_studio(item.name);
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                                Rectangle {
                                                                    height: 32px;
                                                                    border-radius: 7px;
                                                                    background: remove-touch.has-hover && item.is_deletable ? Ink.overlay-hover : transparent;
                                                                    opacity: item.is_deletable ? 1 : 0.4;
                                                                    Text {
                                                                        x: 10px;
                                                                        height: 100%;
                                                                        text: item.is_user ? "Remove pack" : "System packs can't be removed";
                                                                        font-size: 13px;
                                                                        color: item.is_deletable ? Ink.negative : Ink.muted;
                                                                        vertical-alignment: center;
                                                                    }
                                                                    remove-touch := TouchArea {
                                                                        mouse-cursor: item.is_deletable ? pointer : default;
                                                                        clicked => {
                                                                            if item.is_deletable {
                                                                                root.delete_theme(item.name);
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 1px;
                                    background: Ink.row-rule;
                                }
                                Rectangle { height: 24px; }
                            }
                        }
                    }
                }
            }

            if root.page == 1: HorizontalLayout {
                vertical-stretch: 1;

                // Roles rail.
                VerticalLayout {
                    width: 208px;

                    VerticalLayout {
                        vertical-stretch: 0;
                        padding: 16px;
                        padding-bottom: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            Text {
                                text: "Roles";
                                font-size: 13px;
                                font-weight: 500;
                                color: Ink.text;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.studio_assigned + " of " + root.studio_roles.length;
                                font-size: Type.small;
                                color: Ink.faint;
                            }
                        }
                        Rectangle {
                            height: 2px;
                            background: Ink.raised;
                            Rectangle {
                                x: 0;
                                height: 100%;
                                width: root.studio_roles.length == 0 ? 0px : parent.width * root.studio_assigned / root.studio_roles.length;
                                background: Ink.accent;
                            }
                        }
                        Text {
                            text: root.studio_coverage_note;
                            font-size: Type.small;
                            color: Ink.muted;
                            wrap: word-wrap;
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-bottom: 8px;

                            for role in root.studio_roles: VerticalLayout {
                                if role.first: Text {
                                    height: 32px;
                                    text: role.group;
                                    font-size: Type.small;
                                    color: Ink.faint;
                                    vertical-alignment: bottom;
                                    x: 8px;
                                }

                                role-row := Rectangle {
                                    property <bool> selected: role.id == root.studio_selected_role;
                                    height: 32px;
                                    border-radius: 7px;
                                    background: self.selected ? Ink.raised : (row.has-hover ? Ink.hover : transparent);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 10px;
                                        spacing: 10px;

                                        Rectangle {
                                            width: 20px;
                                            if role.assigned: Image {
                                                y: (parent.height - 20px) / 2;
                                                width: 20px;
                                                height: 20px;
                                                source: role.thumb;
                                                image-fit: contain;
                                            }
                                            if !role.assigned: Rectangle {
                                                x: 7px;
                                                y: (parent.height - 6px) / 2;
                                                width: 6px;
                                                height: 6px;
                                                border-radius: 3px;
                                                background: Ink.control;
                                            }
                                        }

                                        Text {
                                            text: role.label;
                                            font-size: 13px;
                                            font-weight: role-row.selected ? 500 : 400;
                                            color: role.assigned || role-row.selected ? Ink.text : Ink.muted;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        if role.frames > 1: Text {
                                            text: role.frames + " frames";
                                            font-size: Type.small;
                                            color: Ink.faint;
                                            vertical-alignment: center;
                                        }
                                    }

                                    row := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.studio_select_role(role.id); }
                                    }
                                }
                            }
                        }
                    }

                    RowRule { }
                    HorizontalLayout {
                        padding: 12px;
                        FillBtn {
                            height: 32px;
                            horizontal-stretch: 1;
                            label: "Fill empty roles";
                            quiet: true;
                            clicked => { root.studio_fill_empty(); }
                        }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Ink.rule;
                }

                // The canvas: a toolbar, the ruled board, and the frames.
                studio_drop := DropArea {
                    horizontal-stretch: 1;
                    can-drop(event) => { return DragAction.copy; }
                    dropped(event) => {
                        root.studio_files_dropped(event.data);
                        return DragAction.copy;
                    }

                    VerticalLayout {
                        HorizontalLayout {
                            height: 52px;
                            padding-left: 20px;
                            padding-right: 16px;
                            spacing: 12px;
                            Text {
                                text: root.studio_role_label;
                                font-size: Type.body;
                                font-weight: 500;
                                color: Ink.text;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.studio_frames.length == 0 ? "No art"
                                    : root.studio_edge + " × " + root.studio_edge + " px" + (root.studio_frames.length > 1 ? ", frame " + (root.studio_frame_index + 1) + " of " + root.studio_frames.length : "");
                                font-size: 13px;
                                color: Ink.faint;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            VerticalLayout {
                                alignment: center;
                                Segments {
                                    height: 30px;
                                    SegmentBtn {
                                        label: "Black";
                                        active: root.studio_canvas_bg == 0;
                                        clicked => { root.studio_canvas_bg = 0; }
                                    }
                                    SegmentBtn {
                                        label: "Grey";
                                        active: root.studio_canvas_bg == 2;
                                        clicked => { root.studio_canvas_bg = 2; }
                                    }
                                    SegmentBtn {
                                        label: "White";
                                        active: root.studio_canvas_bg == 1;
                                        clicked => { root.studio_canvas_bg = 1; }
                                    }
                                }
                            }
                        }

                        RowRule { }

                        VerticalLayout {
                            vertical-stretch: 1;
                            padding: 20px;
                            padding-left: 12px;
                                stage := Rectangle {
                                    vertical-stretch: 1;
                                    min-height: 160px;

                                    property <length> ruler: 28px;
                                    property <bool> has-frame: root.studio_frames.length > 0;
                                    property <int> edge: max(1, root.studio_edge);
                                    property <length> side: max(64px, min(self.width - self.ruler - 6px, self.height - self.ruler - 6px));
                                    property <length> cell: self.side / self.edge;
                                    property <length> board-x: self.ruler + (self.width - self.ruler - self.side) / 2;
                                    property <length> board-y: self.ruler + (self.height - self.ruler - self.side) / 2;
                                    property <int> major: self.cell * 8 >= 30px ? 8 : (self.cell * 16 >= 30px ? 16 : (self.cell * 32 >= 30px ? 32 : 64));
                                    property <int> minor: self.cell >= 5px ? 1 : (self.cell * 2 >= 5px ? 2 : (self.cell * 4 >= 5px ? 4 : 8));
                                    property <bool> pointing: self.has-frame && board-touch.has-hover;
                                    property <int> hover-x: Math.max(0, Math.min(self.edge - 1, Math.floor(board-touch.mouse-x / self.cell)));
                                    property <int> hover-y: Math.max(0, Math.min(self.edge - 1, Math.floor(board-touch.mouse-y / self.cell)));
                                    property <color> ruler-ink: Ink.faint;

                                    // Ruler ticks along the top and left edges.
                                    for i in Math.floor(stage.edge / stage.minor) + 1: Rectangle {
                                        property <int> at: i * stage.minor;
                                        property <bool> big: Math.mod(self.at, stage.major) == 0;
                                        x: stage.board-x + self.at * stage.cell;
                                        y: stage.board-y - 4px - self.height;
                                        width: 1px;
                                        height: self.big ? 9px : 4px;
                                        background: self.big ? stage.ruler-ink : Ink.control;
                                    }
                                    for i in Math.floor(stage.edge / stage.minor) + 1: Rectangle {
                                        property <int> at: i * stage.minor;
                                        property <bool> big: Math.mod(self.at, stage.major) == 0;
                                        x: stage.board-x - 4px - self.width;
                                        y: stage.board-y + self.at * stage.cell;
                                        width: self.big ? 9px : 4px;
                                        height: 1px;
                                        background: self.big ? stage.ruler-ink : Ink.control;
                                    }
                                    for i in Math.ceil(stage.edge / stage.major): Text {
                                        x: stage.board-x + i * stage.major * stage.cell + 3px;
                                        y: stage.board-y - 26px;
                                        height: 14px;
                                        text: i * stage.major;
                                        font-size: 11px;
                                        color: stage.ruler-ink;
                                    }
                                    for i in Math.ceil(stage.edge / stage.major): Text {
                                        x: stage.board-x - 28px;
                                        y: stage.board-y + i * stage.major * stage.cell + 1px;
                                        width: 22px;
                                        height: 14px;
                                        text: i * stage.major;
                                        font-size: 11px;
                                        color: stage.ruler-ink;
                                        horizontal-alignment: right;
                                    }

                                    // The board.
                                    Rectangle {
                                        x: stage.board-x;
                                        y: stage.board-y;
                                        width: stage.side;
                                        height: stage.side;
                                        border-radius: 4px;
                                        clip: true;
                                        background: root.studio_canvas_bg == 1 ? #f2f2f2 : (root.studio_canvas_bg == 2 ? #6b6b6b : #000000);

                                        if stage.has-frame: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: root.studio_frames[root.studio_frame_index];
                                            image-fit: fill;
                                            image-rendering: pixelated;
                                        }

                                        if stage.cell >= 8px: Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            property <color> line: root.studio_canvas_bg == 1 ? #0000001A : #FFFFFF10;
                                            for i in stage.edge + 1: Rectangle {
                                                x: i * stage.cell;
                                                y: 0;
                                                width: 1px;
                                                height: 100%;
                                                background: parent.line;
                                            }
                                            for i in stage.edge + 1: Rectangle {
                                                x: 0;
                                                y: i * stage.cell;
                                                width: 100%;
                                                height: 1px;
                                                background: parent.line;
                                            }
                                        }

                                        if stage.pointing: Rectangle {
                                            x: stage.hover-x * stage.cell;
                                            y: stage.hover-y * stage.cell;
                                            width: stage.cell;
                                            height: stage.cell;
                                            border-width: 1px;
                                            border-color: root.studio_canvas_bg == 1 ? #00000066 : #FFFFFF77;
                                        }

                                        // The hotspot, drawn as a registration mark.
                                        if stage.has-frame: Rectangle {
                                            property <length> cx: (root.studio_hotspot_x + 0.5) * stage.cell;
                                            property <length> cy: (root.studio_hotspot_y + 0.5) * stage.cell;
                                            property <length> ring: max(18px, stage.cell + 10px);
                                            Rectangle {
                                                x: root.studio_hotspot_x * stage.cell;
                                                y: root.studio_hotspot_y * stage.cell;
                                                width: stage.cell;
                                                height: stage.cell;
                                                background: Ink.mark.transparentize(0.6);
                                            }
                                            Rectangle {
                                                x: parent.cx - parent.ring / 2;
                                                y: parent.cy - parent.ring / 2;
                                                width: parent.ring;
                                                height: parent.ring;
                                                border-radius: parent.ring / 2;
                                                border-width: 1.5px;
                                                border-color: Ink.mark;
                                            }
                                            Rectangle {
                                                x: parent.cx - parent.ring / 2 - 7px;
                                                y: parent.cy - 0.5px;
                                                width: parent.ring + 14px;
                                                height: 1px;
                                                background: Ink.mark;
                                            }
                                            Rectangle {
                                                x: parent.cx - 0.5px;
                                                y: parent.cy - parent.ring / 2 - 7px;
                                                width: 1px;
                                                height: parent.ring + 14px;
                                                background: Ink.mark;
                                            }
                                        }

                                        if !stage.has-frame: VerticalLayout {
                                            padding: 20px;
                                            alignment: center;
                                            spacing: 10px;
                                            Text {
                                                text: studio_drop.has-drag ? "Drop to add frames" : "No art for " + root.studio_role_label + " yet";
                                                font-size: 16px;
                                                font-weight: 600;
                                                color: root.studio_canvas_bg == 1 ? #000000 : #ffffff;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: "Drop PNG files here. Several files become an animation, in filename order.";
                                                font-size: 12px;
                                                color: root.studio_canvas_bg == 1 ? #555555 : #b4b4b4;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                FillBtn {
                                                    label: "Choose images";
                                                    quiet: true;
                                                    clicked => { root.studio_pick_frames(false); }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        x: stage.board-x - 1px;
                                        y: stage.board-y - 1px;
                                        width: stage.side + 2px;
                                        height: stage.side + 2px;
                                        border-radius: 5px;
                                        border-width: 1px;
                                        border-color: keys.has-focus ? Ink.muted : (studio_drop.has-drag ? Ink.accent : Ink.raised);
                                    }

                                    // Where the pointer is, then where the hotspot is, flagged on both rulers.
                                    if stage.pointing: Rectangle {
                                        x: stage.board-x + (stage.hover-x + 0.5) * stage.cell - self.width / 2;
                                        y: stage.board-y - 25px;
                                        width: hover-top.preferred-width + 10px;
                                        height: 17px;
                                        border-radius: 4px;
                                        background: Ink.text;
                                        hover-top := Text {
                                            text: stage.hover-x;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Ink.ground;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if stage.pointing: Rectangle {
                                        x: stage.board-x - self.width - 3px;
                                        y: stage.board-y + (stage.hover-y + 0.5) * stage.cell - self.height / 2;
                                        width: hover-left.preferred-width + 10px;
                                        height: 17px;
                                        border-radius: 4px;
                                        background: Ink.text;
                                        hover-left := Text {
                                            text: stage.hover-y;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Ink.ground;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if stage.has-frame: Rectangle {
                                        x: stage.board-x + (root.studio_hotspot_x + 0.5) * stage.cell - self.width / 2;
                                        y: stage.board-y - 25px;
                                        width: hot-top.preferred-width + 10px;
                                        height: 17px;
                                        border-radius: 4px;
                                        background: Ink.accent;
                                        hot-top := Text {
                                            text: root.studio_hotspot_x;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Ink.on-accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if stage.has-frame: Rectangle {
                                        x: stage.board-x - self.width - 3px;
                                        y: stage.board-y + (root.studio_hotspot_y + 0.5) * stage.cell - self.height / 2;
                                        width: hot-left.preferred-width + 10px;
                                        height: 17px;
                                        border-radius: 4px;
                                        background: Ink.accent;
                                        hot-left := Text {
                                            text: root.studio_hotspot_y;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Ink.on-accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    board-touch := TouchArea {
                                        x: stage.board-x;
                                        y: stage.board-y;
                                        width: stage.side;
                                        height: stage.side;
                                        enabled: stage.has-frame;
                                        mouse-cursor: stage.has-frame ? MouseCursor.crosshair : MouseCursor.default;
                                        pointer-event(event) => {
                                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                                keys.focus();
                                                root.studio_set_hotspot(self.mouse-x / self.width, self.mouse-y / self.height);
                                            }
                                        }
                                        moved => {
                                            if self.pressed {
                                                root.studio_set_hotspot(
                                                    max(0, min(1, self.mouse-x / self.width)),
                                                    max(0, min(1, self.mouse-y / self.height)));
                                            }
                                        }
                                    }

                                    keys := FocusScope {
                                        width: 0px;
                                        height: 0px;
                                        key-pressed(event) => {
                                            if event.text == Key.LeftArrow {
                                                root.studio_nudge_hotspot(-1, 0);
                                                return accept;
                                            }
                                            if event.text == Key.RightArrow {
                                                root.studio_nudge_hotspot(1, 0);
                                                return accept;
                                            }
                                            if event.text == Key.UpArrow {
                                                root.studio_nudge_hotspot(0, -1);
                                                return accept;
                                            }
                                            if event.text == Key.DownArrow {
                                                root.studio_nudge_hotspot(0, 1);
                                                return accept;
                                            }
                                            reject
                                        }
                                    }
                                }
                        }

                        if root.studio_frames.length > 0: RowRule { }
                        if root.studio_frames.length > 0: HorizontalLayout {
                            height: 68px;
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;

                            ScrollView {
                                horizontal-stretch: 1;
                                Rectangle {
                                    x: 0;
                                    y: 11px;
                                    width: root.studio_frames.length * 50px + 44px;
                                    height: 44px;

                                    for frame[index] in root.studio_frames: Rectangle {
                                        x: index * 50px;
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 8px;
                                        background: index == root.studio_frame_index ? Ink.raised : (frame-touch.has-hover ? Ink.hover : Ink.surface);
                                        Image {
                                            x: 8px;
                                            y: 6px;
                                            width: 22px;
                                            height: 22px;
                                            source: frame;
                                            image-fit: contain;
                                        }
                                        Text {
                                            x: 0;
                                            y: 28px;
                                            width: parent.width - 6px;
                                            height: 14px;
                                            text: index + 1;
                                            font-size: 11px;
                                            color: index == root.studio_frame_index ? Ink.text : Ink.faint;
                                            horizontal-alignment: right;
                                        }
                                        frame-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.studio_select_frame(index); }
                                        }
                                    }

                                    Rectangle {
                                        x: root.studio_frames.length * 50px;
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: Ink.raised;
                                        background: add-touch.has-hover ? Ink.hover : transparent;
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "+";
                                            font-size: 16px;
                                            color: Ink.muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        add-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.studio_pick_frames(false); }
                                        }
                                    }
                                }
                            }

                            if root.studio_frames.length > 1: VerticalLayout {
                                alignment: center;
                                GlyphBtn {
                                    glyph: "←";
                                    enabled: root.studio_frame_index > 0;
                                    clicked => { root.studio_move_frame(-1); }
                                }
                            }
                            if root.studio_frames.length > 1: VerticalLayout {
                                alignment: center;
                                GlyphBtn {
                                    glyph: "→";
                                    enabled: root.studio_frame_index < root.studio_frames.length - 1;
                                    clicked => { root.studio_move_frame(1); }
                                }
                            }
                            if root.studio_frames.length > 1: VerticalLayout {
                                alignment: center;
                                TextBtn {
                                    label: "Remove frame";
                                    clicked => { root.studio_remove_frame(); }
                                }
                            }
                            Rectangle { width: 6px; }
                            VerticalLayout {
                                alignment: center;
                                TextBtn {
                                    label: "Replace";
                                    clicked => { root.studio_pick_frames(true); }
                                }
                            }
                            Rectangle { width: 6px; }
                            VerticalLayout {
                                alignment: center;
                                TextBtn {
                                    label: "Clear role";
                                    danger: true;
                                    clicked => { root.studio_clear_role(); }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Ink.rule;
                }

                // Inspector: only what applies to this role, then the pack.
                VerticalLayout {
                    width: 260px;

                    property <int> tick: 0;
                    Timer {
                        interval: max(10, root.studio_delay) * 1ms;
                        running: root.page == 1 && root.studio_frames.length > 1;
                        triggered => {
                            parent.tick = Math.mod(parent.tick + 1, max(1, root.studio_frames.length));
                        }
                    }
                    property <image> live: root.studio_frames[Math.min(self.tick, root.studio_frames.length - 1)];

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 16px;
                            padding-right: 18px;
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: root.studio_role_label;
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Ink.text;
                                }
                                Text {
                                    text: root.studio_role_hint;
                                    font-size: 13px;
                                    color: Ink.muted;
                                    wrap: word-wrap;
                                }
                            }

                            if root.studio_frames.length == 0: Text {
                                text: "No art yet. Drop PNG files on the canvas, or leave it empty and it will " + (root.studio_fill_missing ? "use your Default art." : "fall back to Adwaita.");
                                font-size: 13px;
                                color: Ink.muted;
                                wrap: word-wrap;
                            }

                            if root.studio_frames.length > 0: VerticalLayout {
                                spacing: 12px;

                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text {
                                            text: "Hotspot";
                                            font-size: Type.small;
                                            color: Ink.faint;
                                        }
                                        Text {
                                            text: root.studio_hotspot_x + ", " + root.studio_hotspot_y;
                                            font-size: Type.figure;
                                            font-weight: 500;
                                            color: Ink.accent;
                                        }
                                        Text {
                                            text: "on a " + root.studio_edge + " px frame";
                                            font-size: Type.small;
                                            color: Ink.faint;
                                        }
                                    }
                                    GridLayout {
                                        spacing: 4px;
                                        Row {
                                            Rectangle { width: 28px; height: 28px; }
                                            GlyphBtn {
                                                width: 28px;
                                                height: 28px;
                                                glyph: "↑";
                                                clicked => { root.studio_nudge_hotspot(0, -1); }
                                            }
                                        }
                                        Row {
                                            GlyphBtn {
                                                width: 28px;
                                                height: 28px;
                                                glyph: "←";
                                                clicked => { root.studio_nudge_hotspot(-1, 0); }
                                            }
                                            GlyphBtn {
                                                width: 28px;
                                                height: 28px;
                                                glyph: "↓";
                                                clicked => { root.studio_nudge_hotspot(0, 1); }
                                            }
                                            GlyphBtn {
                                                width: 28px;
                                                height: 28px;
                                                glyph: "→";
                                                clicked => { root.studio_nudge_hotspot(1, 0); }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    TextBtn {
                                        label: "Place automatically";
                                        clicked => { root.studio_auto_hotspot(); }
                                    }
                                }

                                RowRule { }

                                Text {
                                    text: "Actual size";
                                    font-size: Type.small;
                                    color: Ink.faint;
                                }
                                Rectangle {
                                    height: 112px;
                                    border-radius: 10px;
                                    clip: true;
                                    VerticalLayout {
                                        for shade in [#f2f2f2, #000000]: Rectangle {
                                            background: shade;
                                            border-width: shade == #000000 ? 1px : 0px;
                                            border-color: Ink.raised;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 16px;
                                                for px in [24, 32, 48]: VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        width: px * 1px;
                                                        height: px * 1px;
                                                        source: live;
                                                        image-fit: contain;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                RowRule { }

                                HorizontalLayout {
                                    Text {
                                        text: "Animation";
                                        font-size: Type.small;
                                        color: Ink.faint;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: root.studio_frames.length > 1 ? root.studio_frames.length + " frames" : "Still";
                                        font-size: Type.small;
                                        color: Ink.muted;
                                    }
                                }
                                if root.studio_frames.length > 1: Segments {
                                    height: 30px;
                                    for delay in [50, 80, 120, 200]: SegmentBtn {
                                        label: delay + " ms";
                                        active: root.studio_delay == delay;
                                        clicked => { root.studio_set_delay(delay); }
                                    }
                                }
                                if root.studio_frames.length == 1: Text {
                                    text: "Add frames to animate this role.";
                                    font-size: 13px;
                                    color: Ink.muted;
                                    wrap: word-wrap;
                                }
                            }

                            Rectangle { height: 4px; }
                            RowRule { }
                            Rectangle { height: 4px; }

                            Text {
                                text: "Pack";
                                font-size: 13px;
                                font-weight: 500;
                                color: Ink.text;
                            }
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: "Name"; font-size: Type.small; color: Ink.faint; }
                                Field {
                                    placeholder: "Custom Pointer";
                                    value <=> root.studio_name;
                                    edited => { root.studio_meta_changed(); }
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: "Description"; font-size: Type.small; color: Ink.faint; }
                                Field {
                                    placeholder: "Optional";
                                    value <=> root.studio_comment;
                                    edited => { root.studio_meta_changed(); }
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: "Sizes included"; font-size: Type.small; color: Ink.faint; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    for size in root.studio_sizes: CheckChip {
                                        label: size.px;
                                        checked: size.on;
                                        clicked => { root.studio_toggle_size(size.px); }
                                    }
                                }
                            }
                            ToggleRow {
                                title: "Fill empty roles";
                                hint: "Use Default art where a role has none.";
                                checked <=> root.studio_fill_missing;
                                toggled => { root.studio_meta_changed(); }
                            }

                            RowRule { }

                            VerticalLayout {
                                spacing: 6px;
                                Text { text: "Start from an installed pack"; font-size: Type.small; color: Ink.faint; }
                                MenuSelect {
                                    choices: root.studio_theme_choices;
                                    selected <=> root.studio_open_index;
                                    enabled: root.studio_theme_choices.length > 0;
                                }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                TextBtn {
                                    label: "Open pack";
                                    clicked => { root.studio_open_theme(root.studio_open_index); }
                                }
                                TextBtn {
                                    label: "Start over";
                                    danger: true;
                                    clicked => { root.studio_new_project(); }
                                }
                            }
                        }
                    }

                    RowRule { }
                    VerticalLayout {
                        padding: 16px;
                        padding-top: 14px;
                        spacing: 8px;
                        FillBtn {
                            label: "Install theme";
                            clicked => { root.studio_export(); }
                        }
                        Text {
                            text: "~/.local/share/icons/" + root.studio_folder;
                            font-size: Type.small;
                            color: Ink.faint;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            if root.page == 2: settings-scroll := ScrollView {
                vertical-stretch: 1;

                Timer {
                    interval: 30ms;
                    running: root.jump-to-account;
                    triggered => {
                        settings-scroll.viewport-y = -account-section.y + 24px;
                        root.jump-to-account = false;
                    }
                }

                VerticalLayout {
                    padding: 29px;
                    padding-top: 24px;
                    padding-bottom: 40px;
                    spacing: 32px;

                    Text {
                        text: "Settings";
                        font-size: Type.title;
                        font-weight: 600;
                        color: Ink.text;
                    }

                    SettingsSection {
                        title: "Appearance";
                        summary: root.appearance == 0 ? "Follows your desktop, now " + (Ink.dark ? "dark." : "light.") : (root.appearance == 1 ? "Always dark." : "Always light.");
                        HorizontalLayout {
                            min-height: 56px;
                            spacing: 16px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Theme"; font-weight: 500; color: Ink.text; }
                                Text { text: "Your pointer art is never recoloured."; font-size: 13px; color: Ink.muted; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Segments {
                                    for choice[index] in ["System", "Dark", "Light"]: SegmentBtn {
                                        label: choice;
                                        active: root.appearance == index;
                                        clicked => {
                                            root.appearance = index;
                                            root.settings_changed();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    RowRule { }

                    SettingsSection {
                        title: "Pointer";
                        summary: root.active_display_name != "" ? root.active_display_name + " at " + root.active_size + " px." : "No pointer applied yet.";
                        HorizontalLayout {
                            min-height: 56px;
                            spacing: 16px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Size"; font-weight: 500; color: Ink.text; }
                                Text { text: "In pixels, before display scaling."; font-size: 13px; color: Ink.muted; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Segments {
                                    for px in [16, 24, 32, 48, 64]: SegmentBtn {
                                        label: px;
                                        active: root.active_size == px;
                                        clicked => { root.size_changed(px); }
                                    }
                                }
                            }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Apply a new size right away";
                            hint: "Off: the size waits for the next pack you apply.";
                            checked <=> root.apply_size_immediately;
                            toggled => { root.settings_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Switch to packs as you add them";
                            hint: "Applies a pack as soon as it is installed, from Library or Studio.";
                            checked <=> root.auto_apply_on_import;
                            toggled => { root.settings_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Show your packs";
                            hint: "Installed in ~/.local/share/icons and ~/.icons.";
                            checked <=> root.show_user_themes;
                            toggled => { root.filter_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Show system packs";
                            hint: "Installed in /usr/share/icons.";
                            checked <=> root.show_system_themes;
                            toggled => { root.filter_changed(); }
                        }
                    }

                    RowRule { }

                    SettingsSection {
                        title: "Where it is written";
                        summary: root.targets-on + " of 8 places are kept in step. Turn one off if another tool manages it.";
                        ToggleRow {
                            title: "Hyprland session";
                            hint: "Sets the pointer live with hyprctl setcursor.";
                            checked <=> root.apply_hyprland;
                            toggled => { root.settings_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "GNOME settings";
                            hint: "The cursor theme and size in gsettings.";
                            checked <=> root.apply_gsettings;
                            toggled => { root.settings_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "GTK apps";
                            hint: "settings.ini for GTK 3 and 4, and gtkrc-2.0.";
                            checked <=> root.apply_gtk;
                            toggled => { root.settings_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Qt and KDE apps";
                            hint: "The Mouse section of kdeglobals.";
                            checked <=> root.apply_qt;
                            toggled => { root.settings_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Login environment";
                            hint: "XCURSOR and HYPRCURSOR variables in environment.d.";
                            checked <=> root.apply_environment;
                            toggled => { root.settings_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "X11 apps";
                            hint: ".Xresources, merged with xrdb.";
                            checked <=> root.apply_xresources;
                            toggled => { root.settings_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Fallback theme";
                            hint: "~/.icons/default inherits the pack, for apps that ignore everything else.";
                            checked <=> root.apply_default_index;
                            toggled => { root.settings_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Flatpak apps";
                            hint: "Lets sandboxed apps read your icon folders.";
                            checked <=> root.apply_flatpak;
                            toggled => { root.settings_changed(); }
                        }
                    }

                    RowRule { }

                    SettingsSection {
                        title: "Hyprland";
                        summary: "How the compositor draws and hides the pointer.";
                        ToggleRow {
                            title: "Use Hyprcursor art";
                            hint: "Sharper scaling when a pack ships it.";
                            checked <=> root.enable_hyprcursor;
                            toggled => { root.hypr_prefs_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Hide while typing";
                            checked <=> root.hide_on_key_press;
                            toggled => { root.hypr_prefs_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Hide on touch";
                            checked <=> root.hide_on_touch;
                            toggled => { root.hypr_prefs_changed(); }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Software cursor";
                            hint: "Try this if the pointer flickers or disappears.";
                            checked <=> root.no_hardware_cursors;
                            toggled => { root.hypr_prefs_changed(); }
                        }
                        RowRule { }
                        HorizontalLayout {
                            min-height: 56px;
                            spacing: 16px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Hide when idle"; font-weight: 500; color: Ink.text; }
                                Text {
                                    text: root.inactive_timeout == 0 ? "The pointer always stays visible." : "Hidden after " + root.inactive_timeout + " seconds without movement.";
                                    font-size: 13px;
                                    color: Ink.muted;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Segments {
                                    for seconds in [0, 3, 5, 10]: SegmentBtn {
                                        label: seconds == 0 ? "Never" : seconds + " s";
                                        active: root.inactive_timeout == seconds;
                                        clicked => {
                                            root.inactive_timeout = seconds;
                                            root.hypr_prefs_changed();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    RowRule { }

                    SettingsSection {
                        title: "Updates";
                        summary: root.update_available ? root.update_tag + " is ready to install." : "Version " + root.app_version + ".";
                        if root.update_available: HorizontalLayout {
                            min-height: 64px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: root.update_tag + " is available"; font-weight: 500; color: Ink.text; }
                                Text { text: "Mouse Me restarts to finish."; font-size: 13px; color: Ink.muted; }
                            }
                            VerticalLayout {
                                alignment: center;
                                FillBtn {
                                    label: "Not now";
                                    quiet: true;
                                    clicked => { root.dismiss_update(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                FillBtn {
                                    label: "Install update";
                                    clicked => { root.apply_update(); }
                                }
                            }
                        }
                        if root.update_available: RowRule { }
                        HorizontalLayout {
                            min-height: 56px;
                            spacing: 16px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Version " + root.app_version; font-weight: 500; color: Ink.text; }
                                Text {
                                    text: root.update_note != "" ? root.update_note : "Checks GitHub releases.";
                                    font-size: 13px;
                                    color: Ink.muted;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                FillBtn {
                                    label: "Check now";
                                    quiet: true;
                                    busy: root.checking_update;
                                    clicked => { root.check_for_update(); }
                                }
                            }
                        }
                        RowRule { }
                        ToggleRow {
                            title: "Update automatically";
                            hint: "Downloads new releases when Mouse Me starts.";
                            checked <=> root.auto_update;
                            toggled => { root.settings_changed(); }
                        }
                        RowRule { }
                        HorizontalLayout {
                            min-height: 56px;
                            spacing: 16px;
                            opacity: root.auto_update ? 1 : 0.5;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "When to install"; font-weight: 500; color: Ink.text; }
                                Text {
                                    text: root.auto_update_when == 2 ? "As soon as it is downloaded, then Mouse Me restarts."
                                        : root.auto_update_when == 1 ? "In the background, ready for the next start."
                                        : "The next time you open Mouse Me.";
                                    font-size: 13px;
                                    color: Ink.muted;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                MenuSelect {
                                    width: 190px;
                                    choices: ["On next launch", "In the background", "Right away"];
                                    selected <=> root.auto_update_when;
                                    enabled: root.auto_update;
                                    changed => { root.settings_changed(); }
                                }
                            }
                        }
                    }

                    RowRule { }

                    account-section := SettingsSection {
                        title: "Account";
                        summary: root.auth_signed_in ? "Signed in as " + (root.auth_session_username != "" ? "@" + root.auth_session_username : root.auth_session_email) + "."
                            : "The same account as the Mouse Me website. You don't need one to use the app.";

                        if root.auth_signed_in: HorizontalLayout {
                            min-height: 76px;
                            spacing: 14px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 22px;
                                    clip: true;
                                    background: Ink.raised;
                                    if root.auth_has_avatar: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.auth_avatar;
                                        image-fit: cover;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: root.auth_session_name != "" ? root.auth_session_name : root.auth_session_email;
                                    font-weight: 500;
                                    color: Ink.text;
                                }
                                Text {
                                    text: (root.auth_joined != "" ? "Joined " + root.auth_joined : "")
                                        + (root.auth_published_label != "" ? (root.auth_joined != "" ? ", " : "") + root.auth_published_label : "");
                                    font-size: 13px;
                                    color: Ink.muted;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                FillBtn {
                                    label: "Open on the web";
                                    quiet: true;
                                    clicked => { root.open_account_page(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                FillBtn {
                                    label: "Sign out";
                                    danger: true;
                                    clicked => { root.sign_out(); }
                                }
                            }
                        }

                        if !root.auth_signed_in: VerticalLayout {
                            padding-top: 12px;
                            padding-bottom: 14px;
                            spacing: 14px;

                            if root.auth_creating: HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Name"; font-size: 13px; font-weight: 500; color: Ink.text; }
                                    Field {
                                        placeholder: "Ada Lovelace";
                                        value <=> root.auth_name;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Username"; font-size: 13px; font-weight: 500; color: Ink.text; }
                                    Field {
                                        placeholder: "ada";
                                        value <=> root.auth_username;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Email"; font-size: 13px; font-weight: 500; color: Ink.text; }
                                    Field {
                                        placeholder: "you@example.com";
                                        value <=> root.auth_email;
                                        accepted => { root.submit-auth(); }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Password"; font-size: 13px; font-weight: 500; color: Ink.text; }
                                    Field {
                                        placeholder: "At least 8 characters";
                                        secret: true;
                                        value <=> root.auth_password;
                                        accepted => { root.submit-auth(); }
                                    }
                                }
                            }
                            if root.auth_creating: HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Confirm password"; font-size: 13px; font-weight: 500; color: Ink.text; }
                                    Field {
                                        placeholder: "Type it again";
                                        secret: true;
                                        value <=> root.auth_confirm;
                                        accepted => { root.submit-auth(); }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.auth_error != "": Text {
                                text: root.auth_error;
                                font-size: 13px;
                                color: Ink.negative;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                FillBtn {
                                    label: root.auth_creating ? "Create account" : "Sign in";
                                    busy: root.auth_busy;
                                    clicked => { root.submit-auth(); }
                                }
                                if !root.auth_creating: TextBtn {
                                    label: "Forgot password";
                                    clicked => { root.open_forgot_password(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                TextBtn {
                                    label: root.auth_creating ? "I already have an account" : "Create an account";
                                    clicked => {
                                        root.auth_creating = !root.auth_creating;
                                        root.auth_error = "";
                                    }
                                }
                            }
                        }
                    }

                    RowRule { }

                    SettingsSection {
                        title: "This machine";
                        summary: root.device_cursor != "" && (root.device_gtk != root.device_cursor || root.device_qt != root.device_cursor)
                            ? "GTK or Qt disagree with the live pointer. Apply the pack again to bring them in step."
                            : "What Mouse Me reads from the session. Copy it into a bug report.";
                        VerticalLayout {
                            padding-top: 10px;
                            padding-bottom: 6px;
                            DebugRow { label: "System"; value: root.device_os; }
                            DebugRow { label: "Desktop"; value: root.device_desktop; }
                            DebugRow { label: "Display"; value: root.device_session; }
                            DebugRow { label: "Kernel"; value: root.device_kernel; }
                            DebugRow { label: "Live"; value: root.device_cursor; }
                            DebugRow { label: "GTK"; value: root.device_gtk; }
                            DebugRow { label: "Qt"; value: root.device_qt; }
                            DebugRow { label: "Variables"; value: root.device_env; }
                        }
                        RowRule { }
                        HorizontalLayout {
                            height: 56px;
                            spacing: 10px;
                            alignment: end;
                            VerticalLayout {
                                alignment: center;
                                FillBtn {
                                    label: "Read again";
                                    quiet: true;
                                    clicked => { root.refresh_device_info(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                FillBtn {
                                    label: "Copy details";
                                    quiet: true;
                                    clicked => { root.copy_device_info(); }
                                }
                            }
                        }
                    }

                    RowRule { }

                    SettingsSection {
                        title: "About";
                        summary: "Mouse Me keeps one pointer in step across Hyprland, GTK, Qt and X11.";
                        VerticalLayout {
                            padding-top: 14px;
                            padding-bottom: 14px;
                            spacing: 14px;
                            Text {
                                text: "Apply a pack in Library and Mouse Me writes its name and size to every place you have switched on above, so apps stop disagreeing about the pointer. Studio turns your own PNG art into a pack.";
                                font-size: Type.body;
                                color: Ink.text;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                FillBtn {
                                    label: "Source on GitHub";
                                    quiet: true;
                                    clicked => { root.open_contribute(); }
                                }
                                FillBtn {
                                    label: "Follow on X";
                                    quiet: true;
                                    clicked => { root.open_x(); }
                                }
                                FillBtn {
                                    label: "Buy me a coffee";
                                    quiet: true;
                                    clicked => { root.open_support(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }
}
