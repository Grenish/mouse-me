import { ScrollView } from "std-widgets.slint";
import {
    Ink,
    Type,
    Display,
    NavBtn,
    UserNav,
    Chip,
    Tag,
    SizePill,
    Toggle,
    ToggleRow,
    FillBtn,
    Field,
    PreviewSlot,
    MenuSelect,
    DebugRow,
    GlyphBtn,
    SectionLabel,
    SegmentBtn,
    Segments,
} from "theme.slint";

export struct ThemeItem {
    name: string,
    display_name: string,
    comment: string,
    cursor_type: string,
    is_active: bool,
    is_deletable: bool,
    is_user: bool,
    path: string,
    preview_default: image,
    preview_pointer: image,
    preview_wait: image,
    preview_text: image,
    has_preview: bool,
}

export struct StudioRole {
    id: string,
    label: string,
    hint: string,
    group: string,
    first: bool,
    assigned: bool,
    frames: int,
    thumb: image,
}

export struct StudioSize {
    px: int,
    on: bool,
}

export component MainWindow inherits Window {
    title: "Mouse Me";
    min-width: 1080px;
    min-height: 700px;
    preferred-width: 1200px;
    preferred-height: 780px;
    background: Ink.desk;
    default-font-family: Type.body;
    default-font-size: 13px;
    default-font-weight: 400;

    in-out property <int> page: 0;
    in-out property <string> active_theme_name: "";
    in-out property <int> active_size: 24;
    in-out property <[ThemeItem]> themes: [];
    in-out property <string> search_query: "";
    in-out property <string> library_filter: "all";
    in-out property <string> library_type: "all";
    in-out property <int> theme_count: 0;
    in-out property <length> library_viewport_y: 0px;
    in-out property <length> library_visible_height: 0px;
    in-out property <string> status_message: "";
    in-out property <bool> status_is_error: false;
    in-out property <bool> is_loading: false;
    in-out property <bool> checking_update: false;

    in-out property <bool> apply_hyprland: true;
    in-out property <bool> apply_gsettings: true;
    in-out property <bool> apply_gtk: true;
    in-out property <bool> apply_qt: true;
    in-out property <bool> apply_environment: true;
    in-out property <bool> apply_xresources: true;
    in-out property <bool> apply_default_index: true;
    in-out property <bool> apply_flatpak: true;
    in-out property <bool> auto_apply_on_import: false;
    in-out property <bool> apply_size_immediately: true;
    in-out property <bool> show_user_themes: true;
    in-out property <bool> show_system_themes: true;
    in-out property <bool> enable_hyprcursor: true;
    in-out property <bool> hide_on_key_press: false;
    in-out property <bool> hide_on_touch: true;
    in-out property <bool> no_hardware_cursors: false;
    in-out property <int> inactive_timeout: 0;
    in-out property <bool> auto_update: false;
    in-out property <int> auto_update_when: 0;

    in-out property <string> studio_name: "Custom Pointer";
    in-out property <string> studio_comment: "";
    in-out property <[StudioRole]> studio_roles: [];
    in-out property <string> studio_selected_role: "left_ptr";
    in-out property <string> studio_role_label: "Default";
    in-out property <string> studio_role_hint: "";
    in-out property <[image]> studio_frames: [];
    in-out property <int> studio_frame_index: 0;
    in-out property <int> studio_edge: 32;
    in-out property <int> studio_hotspot_x: 0;
    in-out property <int> studio_hotspot_y: 0;
    in-out property <int> studio_delay: 80;
    in-out property <[StudioSize]> studio_sizes: [];
    in-out property <bool> studio_fill_missing: true;
    in-out property <int> studio_assigned: 0;
    in-out property <int> studio_canvas_bg: 0;
    in-out property <image> studio_mat_tile;
    in-out property <string> studio_coverage_note: "";
    in-out property <string> studio_folder: "";
    in-out property <[string]> studio_theme_choices: [];
    in-out property <int> studio_open_index: 0;
    in-out property <string> import_note: "Drop a zip, tar.gz, tar.xz, or an unpacked theme folder.";
    in-out property <string> app_version: "0.1.0";
    in-out property <string> update_note: "";
    in-out property <bool> update_available: false;
    in-out property <string> update_tag: "";

    in-out property <bool> auth_signed_in: false;
    in-out property <bool> auth_creating: false;
    in-out property <bool> auth_busy: false;
    in-out property <string> auth_name: "";
    in-out property <string> auth_username: "";
    in-out property <string> auth_email: "";
    in-out property <string> auth_password: "";
    in-out property <string> auth_confirm: "";
    in-out property <string> auth_session_email: "";
    in-out property <string> auth_session_name: "";
    in-out property <string> auth_session_username: "";
    in-out property <string> auth_joined: "";
    in-out property <string> auth_published_label: "";
    in-out property <image> auth_avatar;
    in-out property <bool> auth_has_avatar: false;
    in-out property <string> auth_error: "";
    in-out property <string> device_os: "";
    in-out property <string> device_desktop: "";
    in-out property <string> device_session: "";
    in-out property <string> device_kernel: "";
    in-out property <string> device_cursor: "";
    in-out property <string> device_gtk: "";
    in-out property <string> device_qt: "";
    in-out property <string> device_env: "";

    callback apply_theme(string, int);
    callback import_theme_dialog();
    callback import_folder_dialog();
    callback import_dropped(data-transfer);
    callback studio_files_dropped(data-transfer);
    callback delete_theme(string);
    callback refresh_themes();
    callback search_changed(string);
    callback size_changed(int);
    callback page_changed(int);
    callback filter_changed();
    callback settings_changed();
    callback hypr_prefs_changed();
    callback studio_pick_frames(bool);
    callback studio_select_role(string);
    callback studio_select_frame(int);
    callback studio_remove_frame();
    callback studio_move_frame(int);
    callback studio_clear_role();
    callback studio_fill_empty();
    callback studio_set_hotspot(float, float);
    callback studio_nudge_hotspot(int, int);
    callback studio_auto_hotspot();
    callback studio_set_delay(int);
    callback studio_toggle_size(int);
    callback studio_meta_changed();
    callback studio_open_theme(int);
    callback studio_new_project();
    callback studio_export();
    callback open_themes_folder();
    callback check_for_update();
    callback apply_update();
    callback dismiss_update();
    callback copy_device_info();
    callback refresh_device_info();
    callback open_support();
    callback open_x();
    callback open_contribute();
    callback sign_in();
    callback create_account();
    callback sign_out();
    callback open_forgot_password();
    callback open_account_page();

    function go(p: int) {
        root.page = p;
        root.page_changed(p);
    }

    function submit-auth() {
        if root.auth_creating {
            root.create_account();
        } else {
            root.sign_in();
        }
    }

    property <string> page-title: root.page == 0 ? "Library"
        : root.page == 1 ? "Import"
        : root.page == 2 ? "Studio"
        : root.page == 3 ? "About"
        : root.page == 4 ? (root.auth_signed_in ? "Profile" : (root.auth_creating ? "Create account" : "Sign in"))
        : "Settings";
    property <string> page-sub: root.page == 0 ? "Every pointer installed on this machine."
        : root.page == 1 ? "Install a pack from an archive or a folder."
        : root.page == 2 ? "Make a cursor theme from your own PNG art."
        : root.page == 3 ? "What Mouse Me is, and where it lives on disk."
        : root.page == 4 ? (root.auth_signed_in ? (root.auth_session_username != "" ? "@" + root.auth_session_username : "Your Mouse Me account.") : (root.auth_creating ? "This is the same account as the Mouse Me website." : "Use the email and password from the Mouse Me website."))
        : "Where the pointer is applied, and how it behaves.";
    property <string> sidebar-user-label: !root.auth_signed_in ? "User"
        : (root.auth_session_name != "" ? root.auth_session_name : (root.auth_session_username != "" ? root.auth_session_username : "User"));

    HorizontalLayout {
        padding: 16px;
        spacing: 14px;

        // Floating sidebar
        Rectangle {
            width: 88px;
            border-radius: 28px;
            background: Ink.sidebar;
            border-width: 1px;
            border-color: Ink.stroke;

            VerticalLayout {
                width: 100%;
                height: 100%;
                padding-top: 16px;
                padding-bottom: 14px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 20px;
                        clip: true;
                        background: Ink.parchment;

                        Image {
                            source: @image-url("../assets/mouse-me.png");
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }
                    }
                }

                Display {
                    text: "Mouse\nMe";
                    font-size: 11px;
                    font-weight: 700;
                    color: Ink.parchment;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 8px;
                    background: transparent;
                }

                NavBtn {
                    icon: @image-url("../assets/icons/house.svg");
                    label: "Library";
                    active: root.page == 0;
                    clicked => { root.go(0); }
                }

                NavBtn {
                    icon: @image-url("../assets/icons/download-simple.svg");
                    label: "Import";
                    active: root.page == 1;
                    clicked => { root.go(1); }
                }

                NavBtn {
                    icon: @image-url("../assets/icons/avocado.svg");
                    label: "Studio";
                    active: root.page == 2;
                    clicked => { root.go(2); }
                }

                NavBtn {
                    icon: @image-url("../assets/icons/info.svg");
                    label: "About";
                    active: root.page == 3;
                    clicked => { root.go(3); }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                UserNav {
                    icon: @image-url("../assets/icons/user.svg");
                    label: root.sidebar-user-label;
                    signed-in: root.auth_signed_in;
                    has-photo: root.auth_has_avatar;
                    photo: root.auth_avatar;
                    active: root.page == 4;
                    clicked => { root.go(4); }
                }

                NavBtn {
                    icon: @image-url("../assets/icons/gear.svg");
                    label: "Settings";
                    active: root.page == 5;
                    clicked => { root.go(5); }
                }
            }
        }

        // Main stage
        Rectangle {
            border-radius: 28px;
            background: Ink.panel;
            border-width: 1px;
            border-color: Ink.stroke;
            clip: true;
            horizontal-stretch: 1;

            VerticalLayout {
                width: 100%;
                height: 100%;
                padding: 22px;
                spacing: 16px;

                // Header
                HorizontalLayout {
                    spacing: 16px;

                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        horizontal-stretch: 1;
                        Display {
                            text: root.page-title;
                            font-size: 26px;
                            font-weight: 700;
                            color: Ink.ivory;
                        }

                        Text {
                            text: root.page-sub;
                            font-size: 13px;
                            color: Ink.mist;
                        }
                    }

                    if root.page != 4: VerticalLayout {
                        alignment: center;
                        FillBtn {
                            label: "Refresh";
                            quiet: true;
                            with-icon: true;
                            icon: @image-url("../assets/icons/arrow-clockwise.svg");
                            busy: root.is_loading;
                            clicked => { root.refresh_themes(); }
                        }
                    }
                }

                if root.page == 0: library := VerticalLayout {
                    spacing: 14px;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        Field {
                            width: 260px;
                            placeholder: "Filter by name…";
                            value: root.search_query;
                            edited(t) => { root.search_changed(t); }
                        }

                        Chip {
                            label: "All";
                            active: root.library_filter == "all";
                            clicked => { root.library_filter = "all"; root.filter_changed(); }
                        }

                        Chip {
                            label: "User";
                            active: root.library_filter == "user";
                            clicked => { root.library_filter = "user"; root.filter_changed(); }
                        }

                        Chip {
                            label: "System";
                            active: root.library_filter == "system";
                            clicked => { root.library_filter = "system"; root.filter_changed(); }
                        }

                        Rectangle {
                            width: 8px;
                            height: 36px;
                            background: transparent;
                        }

                        Chip {
                            label: "Any format";
                            active: root.library_type == "all";
                            clicked => { root.library_type = "all"; root.filter_changed(); }
                        }

                        Chip {
                            label: "XCursor";
                            active: root.library_type == "xcursor";
                            clicked => { root.library_type = "xcursor"; root.filter_changed(); }
                        }

                        Chip {
                            label: "Hyprcursor";
                            active: root.library_type == "hyprcursor";
                            clicked => { root.library_type = "hyprcursor"; root.filter_changed(); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            background: transparent;
                        }

                        Text {
                            text: root.theme_count + " packs";
                            font-size: 12px;
                            color: Ink.mist;
                            vertical-alignment: center;
                            height: 100%;
                        }
                    }

                    HorizontalLayout {
                        height: 36px;
                        spacing: 6px;
                        Text {
                            text: "Size";
                            font-size: 11px;
                            color: Ink.mist;
                            vertical-alignment: center;
                            height: 100%;
                        }

                        SizePill {
                            px: 16;
                            active: root.active_size == 16;
                            clicked => { root.size_changed(16); }
                        }

                        SizePill {
                            px: 24;
                            active: root.active_size == 24;
                            clicked => { root.size_changed(24); }
                        }

                        SizePill {
                            px: 32;
                            active: root.active_size == 32;
                            clicked => { root.size_changed(32); }
                        }

                        SizePill {
                            px: 48;
                            active: root.active_size == 48;
                            clicked => { root.size_changed(48); }
                        }

                        SizePill {
                            px: 64;
                            active: root.active_size == 64;
                            clicked => { root.size_changed(64); }
                        }
                    }

                    if root.theme_count == 0: Rectangle {
                        vertical-stretch: 1;
                        border-radius: 20px;
                        background: Ink.well;
                        border-width: 1px;
                        border-color: Ink.stroke;

                        VerticalLayout {
                            alignment: center;
                            spacing: 10px;
                            Display {
                                text: "Nothing on the desk yet";
                                font-size: 16px;
                                font-weight: 700;
                                color: Ink.ivory;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Import a zip from the Import page, or cut a pointer in Studio.";
                                font-size: 13px;
                                color: Ink.mist;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                FillBtn {
                                    label: "Import a pack";
                                    clicked => { root.go(1); }
                                }

                                FillBtn {
                                    label: "Open Studio";
                                    quiet: true;
                                    clicked => { root.go(2); }
                                }
                            }
                        }
                    }

                    if root.theme_count > 0: ScrollView {
                        vertical-stretch: 1;
                        viewport-y <=> root.library_viewport_y;
                        changed visible-height => {
                            root.library_visible_height = self.visible-height;
                        }
                        VerticalLayout {
                            spacing: 10px;
                            padding-right: 8px;

                            for item in root.themes: Rectangle {
                                height: 92px;
                                border-radius: 18px;
                                border-width: 1px;
                                border-color: item.is_active ? Ink.sage : Ink.stroke;
                                background: item.is_active ? #1E4F3428 : Ink.well;

                                HorizontalLayout {
                                    width: 100%;
                                    height: 100%;
                                    padding: 12px;
                                    spacing: 14px;

                                    Rectangle {
                                        width: 176px;
                                        vertical-stretch: 1;
                                        border-radius: 14px;
                                        background: Ink.parchment;
                                        clip: true;

                                        VerticalLayout {
                                            width: 100%;
                                            height: 100%;
                                            alignment: center;

                                            if item.has_preview: HorizontalLayout {
                                                alignment: center;
                                                spacing: 8px;
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                PreviewSlot {
                                                    frame: item.preview_default;
                                                }

                                                PreviewSlot {
                                                    frame: item.preview_pointer;
                                                }

                                                PreviewSlot {
                                                    frame: item.preview_wait;
                                                }

                                                PreviewSlot {
                                                    frame: item.preview_text;
                                                }
                                            }
                                            if !item.has_preview: Text {
                                                height: 32px;
                                                text: "No preview";
                                                font-size: 11px;
                                                color: #5C6B52;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 5px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        vertical-stretch: 1;

                                        Display {
                                            text: item.display_name;
                                            font-size: 15px;
                                            font-weight: 700;
                                            color: Ink.ivory;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: item.comment != "" ? item.comment : item.path;
                                            font-size: 11px;
                                            color: Ink.mist;
                                            overflow: elide;
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Tag {
                                                label: item.cursor_type;
                                                fill: item.cursor_type == "Hyprcursor" ? #1E4F3455 : Ink.ghost;
                                                ink: item.cursor_type == "Hyprcursor" ? Ink.sage : Ink.fog;
                                            }

                                            if item.is_user: Tag {
                                                label: "User";
                                            }

                                            if item.is_active: Tag {
                                                label: "Live";
                                                fill: #C9845A33;
                                                ink: Ink.click;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        vertical-stretch: 1;
                                        HorizontalLayout {
                                            spacing: 8px;

                                            if item.is_deletable: FillBtn {
                                                label: "Remove";
                                                quiet: true;
                                                danger: true;
                                                clicked => { root.delete_theme(item.name); }
                                            }

                                            FillBtn {
                                                label: item.is_active ? "Applied" : "Apply";
                                                quiet: item.is_active;
                                                clicked => {
                                                    if !item.is_active {
                                                        root.apply_theme(item.name, root.active_size);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.page == 1: VerticalLayout {
                    spacing: 16px;
                    vertical-stretch: 1;

                    drop_zone := DropArea {
                        vertical-stretch: 1;
                        min-height: 280px;
                        can-drop(event) => {
                            return DragAction.copy;
                        }
                        dropped(event) => {
                            root.import_dropped(event.data);
                            return DragAction.copy;
                        }

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 24px;
                            border-width: 1.5px;
                            border-color: drop_zone.has-drag ? Ink.sage : Ink.stroke-strong;
                            background: drop_zone.has-drag ? #6B946822 : Ink.well;

                            VerticalLayout {
                                width: 100%;
                                height: 100%;
                                alignment: center;
                                spacing: 12px;
                                padding: 32px;

                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 72px;
                                        height: 72px;
                                        border-radius: 22px;
                                        clip: true;
                                        background: Ink.parchment;
                                        Image {
                                            source: @image-url("../assets/mouse-me.png");
                                            width: 100%;
                                            height: 100%;
                                            image-fit: cover;
                                        }
                                    }
                                }

                                Display {
                                    text: drop_zone.has-drag ? "Release to install" : "Drop a cursor pack here";
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: Ink.ivory;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.import_note;
                                    font-size: 13px;
                                    color: Ink.mist;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 10px;
                                    FillBtn {
                                        label: "Browse archive";
                                        clicked => { root.import_theme_dialog(); }
                                    }

                                    FillBtn {
                                        label: "Browse folder";
                                        quiet: true;
                                        clicked => { root.import_folder_dialog(); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.page == 2: HorizontalLayout {
                    spacing: 14px;
                    vertical-stretch: 1;

                    // Roles: grouped by what the pointer is doing.
                    Rectangle {
                        width: 212px;
                        border-radius: 18px;
                        background: Ink.well;
                        border-width: 1px;
                        border-color: Ink.stroke;

                        VerticalLayout {
                            width: 100%;
                            height: 100%;
                            padding: 14px;
                            padding-bottom: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                Display {
                                    text: "Roles";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Ink.ivory;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.studio_assigned + " of " + root.studio_roles.length + " have art";
                                    font-size: 12px;
                                    color: Ink.mist;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 4px;
                                border-radius: 2px;
                                background: Ink.stroke;
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    height: 100%;
                                    width: root.studio_roles.length == 0 ? 0px : parent.width * root.studio_assigned / root.studio_roles.length;
                                    border-radius: 2px;
                                    background: Ink.sage;
                                }
                            }

                            Text {
                                text: root.studio_coverage_note;
                                font-size: 12px;
                                color: Ink.fog;
                                wrap: word-wrap;
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding-right: 6px;
                                    spacing: 2px;

                                    for role in root.studio_roles: VerticalLayout {
                                        spacing: 2px;

                                        if role.first: Text {
                                            height: 30px;
                                            text: role.group;
                                            font-size: 12px;
                                            color: Ink.mist;
                                            vertical-alignment: bottom;
                                        }

                                        role-row := Rectangle {
                                            property <bool> selected: role.id == root.studio_selected_role;
                                            height: 40px;
                                            border-radius: 10px;
                                            background: self.selected ? #FFFFFF17 : (row.has-hover ? Ink.ghost : #00000000);

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 10px;
                                                spacing: 10px;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 28px;
                                                        height: 28px;
                                                        border-radius: 7px;
                                                        background: role.assigned ? #1D3A28 : #00000000;
                                                        border-width: role.assigned ? 0px : 1px;
                                                        border-color: Ink.stroke-strong;
                                                        if role.assigned: Image {
                                                            x: 3px;
                                                            y: 3px;
                                                            width: 22px;
                                                            height: 22px;
                                                            source: role.thumb;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                }

                                                Text {
                                                    text: role.label;
                                                    font-size: 13px;
                                                    font-weight: role-row.selected ? 600 : 400;
                                                    color: role.assigned || role-row.selected ? Ink.ivory : Ink.fog;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: role.frames > 1 ? role.frames + " frames" : (role.assigned ? "" : "—");
                                                    font-size: 11px;
                                                    color: Ink.mist;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            row := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.studio_select_role(role.id); }
                                            }
                                        }
                                    }
                                }
                            }

                            FillBtn {
                                label: "Fill empty roles";
                                quiet: true;
                                clicked => { root.studio_fill_empty(); }
                            }
                        }
                    }

                    // The mat: the one place this screen spends its colour.
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 18px;
                        background: #16301F;
                        clip: true;

                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.studio_mat_tile;
                            horizontal-tiling: repeat;
                            vertical-tiling: repeat;
                        }

                        studio_drop := DropArea {
                            can-drop(event) => { return DragAction.copy; }
                            dropped(event) => {
                                root.studio_files_dropped(event.data);
                                return DragAction.copy;
                            }

                            VerticalLayout {
                                width: 100%;
                                height: 100%;
                                padding: 18px;
                                spacing: 12px;

                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Display {
                                            text: root.studio_role_label;
                                            font-size: 20px;
                                            font-weight: 600;
                                            color: Ink.ivory;
                                        }
                                        Text {
                                            text: root.studio_role_hint;
                                            font-size: 12px;
                                            color: #B9CDB8;
                                            wrap: word-wrap;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: start;
                                        Segments {
                                            SegmentBtn {
                                                label: "Mat";
                                                active: root.studio_canvas_bg == 0;
                                                clicked => { root.studio_canvas_bg = 0; }
                                            }
                                            SegmentBtn {
                                                label: "Light";
                                                active: root.studio_canvas_bg == 1;
                                                clicked => { root.studio_canvas_bg = 1; }
                                            }
                                            SegmentBtn {
                                                label: "Dark";
                                                active: root.studio_canvas_bg == 2;
                                                clicked => { root.studio_canvas_bg = 2; }
                                            }
                                        }
                                    }
                                }

                                stage := Rectangle {
                                    vertical-stretch: 1;
                                    min-height: 160px;

                                    property <length> ruler: 28px;
                                    property <bool> has-frame: root.studio_frames.length > 0;
                                    property <int> edge: max(1, root.studio_edge);
                                    property <length> side: max(64px, min(self.width - self.ruler - 6px, self.height - self.ruler - 6px));
                                    property <length> cell: self.side / self.edge;
                                    property <length> board-x: self.ruler + (self.width - self.ruler - self.side) / 2;
                                    property <length> board-y: self.ruler + (self.height - self.ruler - self.side) / 2;
                                    property <int> major: self.cell * 8 >= 30px ? 8 : (self.cell * 16 >= 30px ? 16 : (self.cell * 32 >= 30px ? 32 : 64));
                                    property <int> minor: self.cell >= 5px ? 1 : (self.cell * 2 >= 5px ? 2 : (self.cell * 4 >= 5px ? 4 : 8));
                                    property <bool> pointing: self.has-frame && board-touch.has-hover;
                                    property <int> hover-x: Math.max(0, Math.min(self.edge - 1, Math.floor(board-touch.mouse-x / self.cell)));
                                    property <int> hover-y: Math.max(0, Math.min(self.edge - 1, Math.floor(board-touch.mouse-y / self.cell)));
                                    property <color> ruler-ink: #A3C2A4;

                                    // Ruler ticks along the top and left edges.
                                    for i in Math.floor(stage.edge / stage.minor) + 1: Rectangle {
                                        property <int> at: i * stage.minor;
                                        property <bool> big: Math.mod(self.at, stage.major) == 0;
                                        x: stage.board-x + self.at * stage.cell;
                                        y: stage.board-y - 4px - self.height;
                                        width: 1px;
                                        height: self.big ? 9px : 4px;
                                        background: self.big ? stage.ruler-ink : #A3C2A455;
                                    }
                                    for i in Math.floor(stage.edge / stage.minor) + 1: Rectangle {
                                        property <int> at: i * stage.minor;
                                        property <bool> big: Math.mod(self.at, stage.major) == 0;
                                        x: stage.board-x - 4px - self.width;
                                        y: stage.board-y + self.at * stage.cell;
                                        width: self.big ? 9px : 4px;
                                        height: 1px;
                                        background: self.big ? stage.ruler-ink : #A3C2A455;
                                    }
                                    for i in Math.ceil(stage.edge / stage.major): Text {
                                        x: stage.board-x + i * stage.major * stage.cell + 3px;
                                        y: stage.board-y - 26px;
                                        height: 14px;
                                        text: i * stage.major;
                                        font-size: 11px;
                                        color: stage.ruler-ink;
                                    }
                                    for i in Math.ceil(stage.edge / stage.major): Text {
                                        x: stage.board-x - 28px;
                                        y: stage.board-y + i * stage.major * stage.cell + 1px;
                                        width: 22px;
                                        height: 14px;
                                        text: i * stage.major;
                                        font-size: 11px;
                                        color: stage.ruler-ink;
                                        horizontal-alignment: right;
                                    }

                                    // The board.
                                    Rectangle {
                                        x: stage.board-x;
                                        y: stage.board-y;
                                        width: stage.side;
                                        height: stage.side;
                                        border-radius: 4px;
                                        clip: true;
                                        background: root.studio_canvas_bg == 1 ? Ink.parchment : (root.studio_canvas_bg == 2 ? #0B0F0A : #1D3A28);

                                        if stage.has-frame: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: root.studio_frames[root.studio_frame_index];
                                            image-fit: fill;
                                            image-rendering: pixelated;
                                        }

                                        if stage.cell >= 8px: Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            property <color> line: root.studio_canvas_bg == 1 ? #0000001A : #FFFFFF10;
                                            for i in stage.edge + 1: Rectangle {
                                                x: i * stage.cell;
                                                y: 0;
                                                width: 1px;
                                                height: 100%;
                                                background: parent.line;
                                            }
                                            for i in stage.edge + 1: Rectangle {
                                                x: 0;
                                                y: i * stage.cell;
                                                width: 100%;
                                                height: 1px;
                                                background: parent.line;
                                            }
                                        }

                                        if stage.pointing: Rectangle {
                                            x: stage.hover-x * stage.cell;
                                            y: stage.hover-y * stage.cell;
                                            width: stage.cell;
                                            height: stage.cell;
                                            border-width: 1px;
                                            border-color: root.studio_canvas_bg == 1 ? #00000066 : #FFFFFF77;
                                        }

                                        // The hotspot, drawn as a registration mark.
                                        if stage.has-frame: Rectangle {
                                            property <length> cx: (root.studio_hotspot_x + 0.5) * stage.cell;
                                            property <length> cy: (root.studio_hotspot_y + 0.5) * stage.cell;
                                            property <length> ring: max(18px, stage.cell + 10px);
                                            Rectangle {
                                                x: root.studio_hotspot_x * stage.cell;
                                                y: root.studio_hotspot_y * stage.cell;
                                                width: stage.cell;
                                                height: stage.cell;
                                                background: #C9845A88;
                                            }
                                            Rectangle {
                                                x: parent.cx - parent.ring / 2;
                                                y: parent.cy - parent.ring / 2;
                                                width: parent.ring;
                                                height: parent.ring;
                                                border-radius: parent.ring / 2;
                                                border-width: 1.5px;
                                                border-color: Ink.click;
                                            }
                                            Rectangle {
                                                x: parent.cx - parent.ring / 2 - 7px;
                                                y: parent.cy - 0.5px;
                                                width: parent.ring + 14px;
                                                height: 1px;
                                                background: Ink.click;
                                            }
                                            Rectangle {
                                                x: parent.cx - 0.5px;
                                                y: parent.cy - parent.ring / 2 - 7px;
                                                width: 1px;
                                                height: parent.ring + 14px;
                                                background: Ink.click;
                                            }
                                        }

                                        if !stage.has-frame: VerticalLayout {
                                            padding: 20px;
                                            alignment: center;
                                            spacing: 10px;
                                            Display {
                                                text: studio_drop.has-drag ? "Drop to add frames" : "No art for " + root.studio_role_label + " yet";
                                                font-size: 16px;
                                                font-weight: 600;
                                                color: root.studio_canvas_bg == 1 ? Ink.desk : Ink.ivory;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: "Drop PNG files here. Several files become an animation, in filename order.";
                                                font-size: 12px;
                                                color: root.studio_canvas_bg == 1 ? #4D5C46 : #B9CDB8;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                FillBtn {
                                                    label: "Choose images";
                                                    clicked => { root.studio_pick_frames(false); }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        x: stage.board-x - 1px;
                                        y: stage.board-y - 1px;
                                        width: stage.side + 2px;
                                        height: stage.side + 2px;
                                        border-radius: 5px;
                                        border-width: 1px;
                                        border-color: keys.has-focus ? Ink.fog : (studio_drop.has-drag ? Ink.sage : #FFFFFF1F);
                                    }

                                    // Where the pointer is, then where the hotspot is, flagged on both rulers.
                                    if stage.pointing: Rectangle {
                                        x: stage.board-x + (stage.hover-x + 0.5) * stage.cell - self.width / 2;
                                        y: stage.board-y - 25px;
                                        width: hover-top.preferred-width + 10px;
                                        height: 17px;
                                        border-radius: 4px;
                                        background: Ink.sage;
                                        hover-top := Text {
                                            text: stage.hover-x;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Ink.desk;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if stage.pointing: Rectangle {
                                        x: stage.board-x - self.width - 3px;
                                        y: stage.board-y + (stage.hover-y + 0.5) * stage.cell - self.height / 2;
                                        width: hover-left.preferred-width + 10px;
                                        height: 17px;
                                        border-radius: 4px;
                                        background: Ink.sage;
                                        hover-left := Text {
                                            text: stage.hover-y;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Ink.desk;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if stage.has-frame: Rectangle {
                                        x: stage.board-x + (root.studio_hotspot_x + 0.5) * stage.cell - self.width / 2;
                                        y: stage.board-y - 25px;
                                        width: hot-top.preferred-width + 10px;
                                        height: 17px;
                                        border-radius: 4px;
                                        background: Ink.click;
                                        hot-top := Text {
                                            text: root.studio_hotspot_x;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Ink.desk;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if stage.has-frame: Rectangle {
                                        x: stage.board-x - self.width - 3px;
                                        y: stage.board-y + (root.studio_hotspot_y + 0.5) * stage.cell - self.height / 2;
                                        width: hot-left.preferred-width + 10px;
                                        height: 17px;
                                        border-radius: 4px;
                                        background: Ink.click;
                                        hot-left := Text {
                                            text: root.studio_hotspot_y;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Ink.desk;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    board-touch := TouchArea {
                                        x: stage.board-x;
                                        y: stage.board-y;
                                        width: stage.side;
                                        height: stage.side;
                                        enabled: stage.has-frame;
                                        mouse-cursor: stage.has-frame ? MouseCursor.crosshair : MouseCursor.default;
                                        pointer-event(event) => {
                                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                                keys.focus();
                                                root.studio_set_hotspot(self.mouse-x / self.width, self.mouse-y / self.height);
                                            }
                                        }
                                        moved => {
                                            if self.pressed {
                                                root.studio_set_hotspot(
                                                    max(0, min(1, self.mouse-x / self.width)),
                                                    max(0, min(1, self.mouse-y / self.height)));
                                            }
                                        }
                                    }

                                    keys := FocusScope {
                                        width: 0px;
                                        height: 0px;
                                        key-pressed(event) => {
                                            if event.text == Key.LeftArrow {
                                                root.studio_nudge_hotspot(-1, 0);
                                                return accept;
                                            }
                                            if event.text == Key.RightArrow {
                                                root.studio_nudge_hotspot(1, 0);
                                                return accept;
                                            }
                                            if event.text == Key.UpArrow {
                                                root.studio_nudge_hotspot(0, -1);
                                                return accept;
                                            }
                                            if event.text == Key.DownArrow {
                                                root.studio_nudge_hotspot(0, 1);
                                                return accept;
                                            }
                                            reject
                                        }
                                    }
                                }

                                // Frames, in the order they play.
                                if root.studio_frames.length > 0: HorizontalLayout {
                                    spacing: 10px;
                                    height: 52px;

                                    ScrollView {
                                        horizontal-stretch: 1;
                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            width: root.studio_frames.length * 52px + 46px;
                                            height: 46px;

                                            for frame[index] in root.studio_frames: Rectangle {
                                                x: index * 52px;
                                                y: 0;
                                                width: 46px;
                                                height: 46px;
                                                border-radius: 8px;
                                                background: index == root.studio_frame_index ? #FFFFFF1F : (frame-touch.has-hover ? #FFFFFF12 : #00000033);
                                                border-width: index == root.studio_frame_index ? 1px : 0px;
                                                border-color: #FFFFFF55;
                                                Image {
                                                    x: 7px;
                                                    y: 5px;
                                                    width: 26px;
                                                    height: 26px;
                                                    source: frame;
                                                    image-fit: contain;
                                                }
                                                Text {
                                                    x: 0;
                                                    y: 30px;
                                                    width: parent.width - 6px;
                                                    height: 14px;
                                                    text: index + 1;
                                                    font-size: 11px;
                                                    color: index == root.studio_frame_index ? Ink.ivory : Ink.mist;
                                                    horizontal-alignment: right;
                                                }
                                                frame-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.studio_select_frame(index); }
                                                }
                                            }

                                            Rectangle {
                                                x: root.studio_frames.length * 52px;
                                                y: 0;
                                                width: 46px;
                                                height: 46px;
                                                border-radius: 8px;
                                                border-width: 1px;
                                                border-color: #FFFFFF2E;
                                                background: add-touch.has-hover ? #FFFFFF12 : #00000000;
                                                Text {
                                                    width: 100%;
                                                    height: 100%;
                                                    text: "+";
                                                    font-size: 18px;
                                                    color: Ink.fog;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                add-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.studio_pick_frames(false); }
                                                }
                                            }
                                        }
                                    }

                                    if root.studio_frames.length > 1: VerticalLayout {
                                        alignment: center;
                                        GlyphBtn {
                                            glyph: "◀";
                                            enabled: root.studio_frame_index > 0;
                                            clicked => { root.studio_move_frame(-1); }
                                        }
                                    }
                                    if root.studio_frames.length > 1: VerticalLayout {
                                        alignment: center;
                                        GlyphBtn {
                                            glyph: "▶";
                                            enabled: root.studio_frame_index < root.studio_frames.length - 1;
                                            clicked => { root.studio_move_frame(1); }
                                        }
                                    }
                                    if root.studio_frames.length > 1: VerticalLayout {
                                        alignment: center;
                                        FillBtn {
                                            height: 32px;
                                            label: "Remove frame";
                                            quiet: true;
                                            clicked => { root.studio_remove_frame(); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        FillBtn {
                                            height: 32px;
                                            label: "Replace";
                                            quiet: true;
                                            clicked => { root.studio_pick_frames(true); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        FillBtn {
                                            height: 32px;
                                            label: "Clear";
                                            quiet: true;
                                            danger: true;
                                            clicked => { root.studio_clear_role(); }
                                        }
                                    }
                                }

                                // A proof strip at true size, on light and on dark.
                                Rectangle {
                                    height: 62px;
                                    border-radius: 10px;
                                    clip: true;

                                    property <int> tick: 0;
                                    Timer {
                                        interval: max(10, root.studio_delay) * 1ms;
                                        running: root.page == 2 && root.studio_frames.length > 1;
                                        triggered => {
                                            parent.tick = Math.mod(parent.tick + 1, max(1, root.studio_frames.length));
                                        }
                                    }
                                    property <image> live: root.studio_frames[Math.min(self.tick, root.studio_frames.length - 1)];

                                    HorizontalLayout {
                                        for shade in [Ink.parchment, #0B0F0A]: Rectangle {
                                            horizontal-stretch: 1;
                                            background: shade;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 12px;
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                                for px in [24, 32, 48]: VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        width: px * 1px;
                                                        height: px * 1px;
                                                        source: live;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Inspector.
                    Rectangle {
                        width: 260px;
                        border-radius: 18px;
                        background: Ink.well;
                        border-width: 1px;
                        border-color: Ink.stroke;

                        VerticalLayout {
                            width: 100%;
                            height: 100%;

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding: 16px;
                                    padding-right: 20px;
                                    spacing: 10px;

                                    Display {
                                        text: "Hotspot";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Ink.ivory;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Display {
                                            text: root.studio_frames.length > 0 ? root.studio_hotspot_x + ", " + root.studio_hotspot_y : "—";
                                            font-size: 24px;
                                            font-weight: 600;
                                            color: root.studio_frames.length > 0 ? Ink.click : Ink.mist;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.studio_frames.length > 0 ? "px on a " + root.studio_edge + " px frame" : "Add art to place it";
                                            font-size: 12px;
                                            color: Ink.mist;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        GridLayout {
                                            spacing: 4px;
                                            Row {
                                                Rectangle { width: 30px; height: 30px; }
                                                GlyphBtn {
                                                    width: 30px;
                                                    height: 30px;
                                                    glyph: "↑";
                                                    enabled: root.studio_frames.length > 0;
                                                    clicked => { root.studio_nudge_hotspot(0, -1); }
                                                }
                                            }
                                            Row {
                                                GlyphBtn {
                                                    width: 30px;
                                                    height: 30px;
                                                    glyph: "←";
                                                    enabled: root.studio_frames.length > 0;
                                                    clicked => { root.studio_nudge_hotspot(-1, 0); }
                                                }
                                                GlyphBtn {
                                                    width: 30px;
                                                    height: 30px;
                                                    glyph: "↓";
                                                    enabled: root.studio_frames.length > 0;
                                                    clicked => { root.studio_nudge_hotspot(0, 1); }
                                                }
                                                GlyphBtn {
                                                    width: 30px;
                                                    height: 30px;
                                                    glyph: "→";
                                                    enabled: root.studio_frames.length > 0;
                                                    clicked => { root.studio_nudge_hotspot(1, 0); }
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: end;
                                            padding-left: 6px;
                                            horizontal-stretch: 1;
                                            FillBtn {
                                                height: 30px;
                                                label: "Auto-place";
                                                quiet: true;
                                                clicked => { root.studio_auto_hotspot(); }
                                            }
                                        }
                                    }

                                    Rectangle { height: 12px; }

                                    Display {
                                        text: "Animation";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Ink.ivory;
                                    }
                                    Text {
                                        text: root.studio_frames.length > 1
                                            ? root.studio_frames.length + " frames, " + root.studio_delay + " ms each"
                                            : (root.studio_frames.length == 1 ? "One frame. Add more to animate this role." : "—");
                                        font-size: 12px;
                                        color: Ink.fog;
                                        wrap: word-wrap;
                                    }
                                    if root.studio_frames.length > 1: Segments {
                                        for delay in [50, 80, 120, 200]: SegmentBtn {
                                            label: delay + " ms";
                                            active: root.studio_delay == delay;
                                            clicked => { root.studio_set_delay(delay); }
                                        }
                                    }

                                    Rectangle { height: 12px; }

                                    Display {
                                        text: "Theme";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Ink.ivory;
                                    }
                                    Field {
                                        placeholder: "Theme name";
                                        value <=> root.studio_name;
                                        edited => { root.studio_meta_changed(); }
                                    }
                                    Field {
                                        placeholder: "Description (optional)";
                                        value <=> root.studio_comment;
                                        edited => { root.studio_meta_changed(); }
                                    }
                                    Text {
                                        text: "Sizes in the pack, in px";
                                        font-size: 12px;
                                        color: Ink.mist;
                                    }
                                    Segments {
                                        for size in root.studio_sizes: SegmentBtn {
                                            label: size.px;
                                            active: size.on;
                                            clicked => { root.studio_toggle_size(size.px); }
                                        }
                                    }
                                    ToggleRow {
                                        title: "Fill empty roles";
                                        hint: "Roles without art use Default.";
                                        checked <=> root.studio_fill_missing;
                                        toggled => { root.studio_meta_changed(); }
                                    }

                                    Rectangle { height: 12px; }

                                    Display {
                                        text: "Start from";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Ink.ivory;
                                    }
                                    MenuSelect {
                                        choices: root.studio_theme_choices;
                                        selected <=> root.studio_open_index;
                                        enabled: root.studio_theme_choices.length > 0;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        FillBtn {
                                            horizontal-stretch: 1;
                                            label: "Open theme";
                                            quiet: true;
                                            clicked => { root.studio_open_theme(root.studio_open_index); }
                                        }
                                        FillBtn {
                                            horizontal-stretch: 1;
                                            label: "Start over";
                                            quiet: true;
                                            clicked => { root.studio_new_project(); }
                                        }
                                    }
                                    Text {
                                        text: "Both replace the draft in Studio. Installed themes are left as they are.";
                                        font-size: 11px;
                                        color: Ink.mist;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Ink.stroke;
                            }

                            VerticalLayout {
                                padding: 16px;
                                padding-top: 12px;
                                spacing: 8px;
                                FillBtn {
                                    label: "Install theme";
                                    clicked => { root.studio_export(); }
                                }
                                Text {
                                    text: "~/.local/share/icons/" + root.studio_folder;
                                    font-size: 11px;
                                    color: Ink.mist;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                if root.page == 3: VerticalLayout {
                    spacing: 16px;
                    vertical-stretch: 1;

                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 20px;
                        background: Ink.well;
                        border-width: 1px;
                        border-color: Ink.stroke;

                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                spacing: 28px;
                                padding: 32px;

                                // --- HERO SECTION ---
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 16px;

                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 80px;
                                            height: 80px;
                                            border-radius: 22px;
                                            clip: true;
                                            background: Ink.parchment;
                                            Image {
                                                source: @image-url("../assets/mouse-me.png");
                                                width: 100%;
                                                height: 100%;
                                                image-fit: cover;
                                            }
                                        }
                                    }

                                    Display {
                                        text: "Mouse Me";
                                        font-size: 22px;
                                        font-weight: 700;
                                        color: Ink.ivory;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: "Mouse Me is a cursor manager built for Linux desktops — Hyprland and Omarchy in particular — where the pointer still has to agree with GTK, Qt, and XWayland. It is a small app for a daily annoyance: keeping one theme in one place instead of five config files.";
                                        font-size: 13px;
                                        color: Ink.fog;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: "Choose a pack in the library and apply it. Mouse Me writes the theme and size into the live session, desktop settings, and your user environment so the rest of the system follows. Import an archive or a folder, or assemble a simple XCursor theme in Studio.";
                                        font-size: 13px;
                                        color: Ink.fog;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 12px;
                                        Text {
                                            text: "Version " + root.app_version;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Ink.parchment;
                                            vertical-alignment: center;
                                            height: 36px;
                                        }

                                        FillBtn {
                                            label: "Check for updates";
                                            quiet: true;
                                            busy: root.checking_update;
                                            clicked => { root.check_for_update(); }
                                        }
                                    }

                                    if root.update_available: VerticalLayout {
                                        spacing: 12px;
                                        Text {
                                            text: root.update_tag + " is available. Update Mouse Me on this computer?";
                                            font-size: 13px;
                                            color: Ink.ivory;
                                            horizontal-alignment: center;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 10px;
                                            FillBtn {
                                                label: "Update now";
                                                busy: root.checking_update;
                                                clicked => { root.apply_update(); }
                                            }
                                            FillBtn {
                                                label: "Not now";
                                                quiet: true;
                                                clicked => { root.dismiss_update(); }
                                            }
                                        }
                                    }

                                    if root.update_note != "": Text {
                                        text: root.update_note;
                                        font-size: 12px;
                                        color: Ink.mist;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 10px;
                                        FillBtn {
                                            label: "Buy me a coffee";
                                            with-icon: true;
                                            icon: @image-url("../assets/icons/coffee.svg");
                                            clicked => { root.open_support(); }
                                        }

                                        FillBtn {
                                            label: "Follow on X";
                                            quiet: true;
                                            with-icon: true;
                                            icon: @image-url("../assets/icons/x-logo.svg");
                                            clicked => { root.open_x(); }
                                        }

                                        FillBtn {
                                            label: "Contribute";
                                            quiet: true;
                                            with-icon: true;
                                            icon: @image-url("../assets/icons/github-logo.svg");
                                            clicked => { root.open_contribute(); }
                                        }
                                    }
                                }

                                // --- DIVIDER ---
                                Rectangle {
                                    height: 1px;
                                    background: Ink.stroke;
                                }

                                VerticalLayout {
                                    spacing: 14px;

                                    HorizontalLayout {
                                        spacing: 12px;

                                        VerticalLayout {
                                            spacing: 2px;
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Display {
                                                text: "This machine";
                                                font-size: 15px;
                                                font-weight: 700;
                                                color: Ink.ivory;
                                            }
                                            Text {
                                                text: "What Mouse Me sees for the session and the pointer.";
                                                font-size: 12px;
                                                color: Ink.mist;
                                                wrap: word-wrap;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: end;

                                            FillBtn {
                                                label: "Refresh";
                                                quiet: true;
                                                clicked => { root.refresh_device_info(); }
                                            }

                                            FillBtn {
                                                label: "Copy";
                                                quiet: true;
                                                clicked => { root.copy_device_info(); }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        border-radius: 16px;
                                        background: Ink.panel;
                                        border-width: 1px;
                                        border-color: Ink.stroke;

                                        HorizontalLayout {
                                            padding: 18px;
                                            spacing: 28px;

                                            VerticalLayout {
                                                spacing: 2px;
                                                horizontal-stretch: 1;
                                                Display {
                                                    text: "Session";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: Ink.mist;
                                                }
                                                DebugRow {
                                                    label: "OS";
                                                    value: root.device_os;
                                                }
                                                DebugRow {
                                                    label: "Desktop";
                                                    value: root.device_desktop;
                                                }
                                                DebugRow {
                                                    label: "Display";
                                                    value: root.device_session;
                                                }
                                                DebugRow {
                                                    label: "Kernel";
                                                    value: root.device_kernel;
                                                }
                                            }

                                            Rectangle {
                                                width: 1px;
                                                background: Ink.stroke;
                                            }

                                            VerticalLayout {
                                                spacing: 2px;
                                                horizontal-stretch: 1;
                                                Display {
                                                    text: "Pointer";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: Ink.mist;
                                                }
                                                DebugRow {
                                                    label: "Live";
                                                    value: root.device_cursor;
                                                }
                                                DebugRow {
                                                    label: "GTK";
                                                    value: root.device_gtk;
                                                }
                                                DebugRow {
                                                    label: "Qt";
                                                    value: root.device_qt;
                                                }
                                                DebugRow {
                                                    label: "Env";
                                                    value: root.device_env;
                                                }
                                                if root.device_cursor != "" && (root.device_gtk != root.device_cursor || root.device_qt != root.device_cursor): Text {
                                                    text: "GTK, Qt, and the live pointer are not the same.";
                                                    font-size: 11px;
                                                    color: Ink.click;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.page == 4: VerticalLayout {
                    spacing: 16px;
                    vertical-stretch: 1;

                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 20px;
                        background: Ink.well;
                        border-width: 1px;
                        border-color: Ink.stroke;

                        ScrollView {
                        VerticalLayout {
                            alignment: center;
                            padding: 32px;

                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    width: 360px;
                                    spacing: 16px;

                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 88px;
                                            height: 88px;
                                            border-radius: 44px;
                                            clip: true;
                                            background: Ink.ghost;

                                            if root.auth_signed_in && root.auth_has_avatar: Image {
                                                width: 100%;
                                                height: 100%;
                                                source: root.auth_avatar;
                                                image-fit: cover;
                                            }
                                            if !(root.auth_signed_in && root.auth_has_avatar): Image {
                                                x: 28px;
                                                y: 28px;
                                                width: 32px;
                                                height: 32px;
                                                source: @image-url("../assets/icons/user.svg");
                                                image-fit: contain;
                                                colorize: Ink.parchment;
                                            }
                                        }
                                    }

                                    if root.auth_signed_in: VerticalLayout {
                                        spacing: 16px;

                                        Display {
                                            text: root.auth_session_name != "" ? root.auth_session_name : root.auth_session_email;
                                            font-size: 18px;
                                            font-weight: 700;
                                            color: Ink.ivory;
                                            horizontal-alignment: center;
                                        }

                                        if root.auth_session_username != "": Text {
                                            text: "@" + root.auth_session_username;
                                            font-size: 13px;
                                            color: Ink.parchment;
                                            horizontal-alignment: center;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;

                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 14px;
                                                background: Ink.ghost;
                                                VerticalLayout {
                                                    padding: 14px;
                                                    spacing: 4px;
                                                    Display {
                                                        text: "Joined";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: Ink.mist;
                                                    }
                                                    Display {
                                                        text: root.auth_joined != "" ? root.auth_joined : "—";
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        color: Ink.ivory;
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 14px;
                                                background: Ink.ghost;
                                                VerticalLayout {
                                                    padding: 14px;
                                                    spacing: 4px;
                                                    Display {
                                                        text: "On the web";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: Ink.mist;
                                                    }
                                                    Display {
                                                        text: root.auth_published_label != "" ? root.auth_published_label : "None yet";
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        color: Ink.ivory;
                                                    }
                                                }
                                            }
                                        }

                                        FillBtn {
                                            label: "Sign out";
                                            quiet: true;
                                            clicked => { root.sign_out(); }
                                        }
                                    }

                                    if !root.auth_signed_in: VerticalLayout {
                                        spacing: 14px;

                                        if root.auth_creating: VerticalLayout {
                                            spacing: 4px;
                                            Display {
                                                text: "Name";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Ink.mist;
                                            }
                                            Field {
                                                placeholder: "Your name";
                                                value <=> root.auth_name;
                                                accepted => { root.submit-auth(); }
                                            }
                                        }

                                        if root.auth_creating: VerticalLayout {
                                            spacing: 4px;
                                            Display {
                                                text: "Username";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Ink.mist;
                                            }
                                            Field {
                                                placeholder: "your-name";
                                                value <=> root.auth_username;
                                                accepted => { root.submit-auth(); }
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 4px;
                                            Display {
                                                text: "Email";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Ink.mist;
                                            }
                                            Field {
                                                placeholder: "you@example.com";
                                                value <=> root.auth_email;
                                                accepted => { root.submit-auth(); }
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 4px;
                                            Display {
                                                text: "Password";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Ink.mist;
                                            }
                                            Field {
                                                secret: true;
                                                placeholder: "At least 8 characters";
                                                value <=> root.auth_password;
                                                accepted => { root.submit-auth(); }
                                            }
                                        }

                                        if root.auth_creating: VerticalLayout {
                                            spacing: 4px;
                                            Display {
                                                text: "Confirm password";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Ink.mist;
                                            }
                                            Field {
                                                secret: true;
                                                placeholder: "Repeat password";
                                                value <=> root.auth_confirm;
                                                accepted => { root.submit-auth(); }
                                            }
                                        }

                                        if root.auth_error != "": Text {
                                            text: root.auth_error;
                                            font-size: 12px;
                                            color: Ink.danger;
                                            wrap: word-wrap;
                                        }

                                        FillBtn {
                                            label: root.auth_creating ? "Create account" : "Sign in";
                                            busy: root.auth_busy;
                                            clicked => { root.submit-auth(); }
                                        }

                                        if !root.auth_creating: HorizontalLayout {
                                            alignment: center;
                                            forgot := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open_forgot_password(); }
                                                Text {
                                                    text: "Forgot password?";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: forgot.has-hover ? Ink.ivory : Ink.parchment;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text {
                                                text: root.auth_creating ? "Already have an account?" : "No account yet?";
                                                font-size: 12px;
                                                color: Ink.mist;
                                                vertical-alignment: center;
                                            }
                                            switcher := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.auth_creating = !root.auth_creating;
                                                    root.auth_error = "";
                                                    root.auth_confirm = "";
                                                }
                                                Text {
                                                    text: root.auth_creating ? "Sign in" : "Create one";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: switcher.has-hover ? Ink.ivory : Ink.parchment;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        }
                    }
                }

                if root.page == 5: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 14px;
                        padding-right: 8px;

                        Rectangle {
                            border-radius: 18px;
                            background: Ink.well;
                            border-width: 1px;
                            border-color: Ink.stroke;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 4px;
                                Display {
                                    text: "Mouse Me";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Ink.mist;
                                }

                                ToggleRow {
                                    title: "Auto-update";
                                    hint: "When a new release is published, install it according to the permission below.";
                                    checked <=> root.auto_update;
                                    toggled => { root.settings_changed(); }
                                }

                                HorizontalLayout {
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 16px;
                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Display {
                                            text: "When to install";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: root.auto_update ? Ink.ivory : Ink.mist;
                                        }
                                        Text {
                                            text: root.auto_update_when == 2 ? "Install as soon as an update is found, then restart."
                                                : (root.auto_update_when == 1 ? "Download and install quietly. Restart to start using it."
                                                : "Download now, install the next time you open Mouse Me.");
                                            font-size: 11px;
                                            color: Ink.mist;
                                            wrap: word-wrap;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        width: 200px;
                                        MenuSelect {
                                            selected <=> root.auto_update_when;
                                            enabled: root.auto_update;
                                            choices: ["On next launch", "In the background", "Instantly"];
                                            changed => { root.settings_changed(); }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 18px;
                            background: Ink.well;
                            border-width: 1px;
                            border-color: Ink.stroke;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 4px;
                                Display {
                                    text: "Pointer size";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Ink.mist;
                                }

                                HorizontalLayout {
                                    height: 36px;
                                    spacing: 6px;
                                    SizePill {
                                        px: 16;
                                        active: root.active_size == 16;
                                        clicked => { root.size_changed(16); }
                                    }

                                    SizePill {
                                        px: 24;
                                        active: root.active_size == 24;
                                        clicked => { root.size_changed(24); }
                                    }

                                    SizePill {
                                        px: 32;
                                        active: root.active_size == 32;
                                        clicked => { root.size_changed(32); }
                                    }

                                    SizePill {
                                        px: 48;
                                        active: root.active_size == 48;
                                        clicked => { root.size_changed(48); }
                                    }

                                    SizePill {
                                        px: 64;
                                        active: root.active_size == 64;
                                        clicked => { root.size_changed(64); }
                                    }
                                }

                                ToggleRow {
                                    title: "Apply size immediately";
                                    hint: "Changing a size pill writes it to the live session.";
                                    checked <=> root.apply_size_immediately;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "Apply imported packs";
                                    hint: "After a successful import, switch to the new theme.";
                                    checked <=> root.auto_apply_on_import;
                                    toggled => { root.settings_changed(); }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 18px;
                            background: Ink.well;
                            border-width: 1px;
                            border-color: Ink.stroke;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 2px;
                                Display {
                                    text: "Where it writes";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Ink.mist;
                                }

                                ToggleRow {
                                    title: "Hyprland";
                                    hint: "hyprctl setcursor for the live session.";
                                    checked <=> root.apply_hyprland;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "GSettings";
                                    hint: "org.gnome.desktop.interface cursor theme and size.";
                                    checked <=> root.apply_gsettings;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "GTK 2/3/4 configs";
                                    hint: "settings.ini and gtkrc-2.0.";
                                    checked <=> root.apply_gtk;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "Qt / KDE";
                                    hint: "kdeglobals Mouse section.";
                                    checked <=> root.apply_qt;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "User environment";
                                    hint: "environment.d with XCURSOR and HYPRCURSOR.";
                                    checked <=> root.apply_environment;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "X11 resources";
                                    hint: ".Xresources and xrdb merge.";
                                    checked <=> root.apply_xresources;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "Default index.theme";
                                    hint: "Inherits the chosen theme from ~/.icons/default.";
                                    checked <=> root.apply_default_index;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "Flatpak overrides";
                                    hint: "Expose icon directories to sandboxed apps.";
                                    checked <=> root.apply_flatpak;
                                    toggled => { root.settings_changed(); }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 18px;
                            background: Ink.well;
                            border-width: 1px;
                            border-color: Ink.stroke;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 2px;
                                Display {
                                    text: "Hyprland cursor";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Ink.mist;
                                }

                                ToggleRow {
                                    title: "Enable Hyprcursor";
                                    hint: "Prefer hyprcursor assets when a pack includes them.";
                                    checked <=> root.enable_hyprcursor;
                                    toggled => { root.hypr_prefs_changed(); }
                                }

                                ToggleRow {
                                    title: "Hide on key press";
                                    hint: "Conceal the pointer while typing.";
                                    checked <=> root.hide_on_key_press;
                                    toggled => { root.hypr_prefs_changed(); }
                                }

                                ToggleRow {
                                    title: "Hide on touch";
                                    hint: "Conceal the pointer during touch input.";
                                    checked <=> root.hide_on_touch;
                                    toggled => { root.hypr_prefs_changed(); }
                                }

                                ToggleRow {
                                    title: "No hardware cursors";
                                    hint: "Force software rendering for the pointer.";
                                    checked <=> root.no_hardware_cursors;
                                    toggled => { root.hypr_prefs_changed(); }
                                }

                                HorizontalLayout {
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 14px;
                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Display {
                                            text: "Inactive timeout";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Ink.ivory;
                                        }

                                        Text {
                                            text: root.inactive_timeout == 0 ? "Stay visible" : root.inactive_timeout + " seconds until hide";
                                            font-size: 11px;
                                            color: Ink.mist;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Chip {
                                                label: "Off";
                                                active: root.inactive_timeout == 0;
                                                clicked => { root.inactive_timeout = 0; root.hypr_prefs_changed(); }
                                            }

                                            Chip {
                                                label: "3s";
                                                active: root.inactive_timeout == 3;
                                                clicked => { root.inactive_timeout = 3; root.hypr_prefs_changed(); }
                                            }

                                            Chip {
                                                label: "5s";
                                                active: root.inactive_timeout == 5;
                                                clicked => { root.inactive_timeout = 5; root.hypr_prefs_changed(); }
                                            }

                                            Chip {
                                                label: "10s";
                                                active: root.inactive_timeout == 10;
                                                clicked => { root.inactive_timeout = 10; root.hypr_prefs_changed(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 18px;
                            background: Ink.well;
                            border-width: 1px;
                            border-color: Ink.stroke;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 2px;
                                Display {
                                    text: "Library";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Ink.mist;
                                }

                                ToggleRow {
                                    title: "Show user packs";
                                    hint: "Themes installed under your home directory.";
                                    checked <=> root.show_user_themes;
                                    toggled => { root.filter_changed(); }
                                }

                                ToggleRow {
                                    title: "Show system packs";
                                    hint: "Themes from /usr/share/icons and friends.";
                                    checked <=> root.show_system_themes;
                                    toggled => { root.filter_changed(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
