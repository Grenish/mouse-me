import { ScrollView } from "std-widgets.slint";
import {
    Ink,
    Type,
    Display,
    NavBtn,
    UserNav,
    Chip,
    Tag,
    SizePill,
    Toggle,
    ToggleRow,
    FillBtn,
    Field,
    PreviewSlot,
    MenuSelect,
    DebugRow,
} from "theme.slint";

export struct ThemeItem {
    name: string,
    display_name: string,
    comment: string,
    cursor_type: string,
    is_active: bool,
    is_deletable: bool,
    is_user: bool,
    path: string,
    preview_default: image,
    preview_pointer: image,
    preview_wait: image,
    preview_text: image,
    has_preview: bool,
}

export struct StudioRole {
    id: string,
    label: string,
    assigned: bool,
}

export component MainWindow inherits Window {
    title: "Mouse Me";
    min-width: 1080px;
    min-height: 700px;
    preferred-width: 1200px;
    preferred-height: 780px;
    background: Ink.desk;
    default-font-family: Type.body;
    default-font-size: 13px;
    default-font-weight: 400;

    in-out property <int> page: 0;
    in-out property <string> active_theme_name: "";
    in-out property <int> active_size: 24;
    in-out property <[ThemeItem]> themes: [];
    in-out property <string> search_query: "";
    in-out property <string> library_filter: "all";
    in-out property <string> library_type: "all";
    in-out property <int> theme_count: 0;
    in-out property <length> library_viewport_y: 0px;
    in-out property <length> library_visible_height: 0px;
    in-out property <string> status_message: "";
    in-out property <bool> status_is_error: false;
    in-out property <bool> is_loading: false;
    in-out property <bool> checking_update: false;

    in-out property <bool> apply_hyprland: true;
    in-out property <bool> apply_gsettings: true;
    in-out property <bool> apply_gtk: true;
    in-out property <bool> apply_qt: true;
    in-out property <bool> apply_environment: true;
    in-out property <bool> apply_xresources: true;
    in-out property <bool> apply_default_index: true;
    in-out property <bool> apply_flatpak: true;
    in-out property <bool> auto_apply_on_import: false;
    in-out property <bool> apply_size_immediately: true;
    in-out property <bool> show_user_themes: true;
    in-out property <bool> show_system_themes: true;
    in-out property <bool> enable_hyprcursor: true;
    in-out property <bool> hide_on_key_press: false;
    in-out property <bool> hide_on_touch: true;
    in-out property <bool> no_hardware_cursors: false;
    in-out property <int> inactive_timeout: 0;
    in-out property <bool> auto_update: false;
    in-out property <int> auto_update_when: 0;

    in-out property <string> studio_name: "Custom Pointer";
    in-out property <string> studio_comment: "";
    in-out property <int> studio_size: 32;
    in-out property <int> studio_hotspot_x: 0;
    in-out property <int> studio_hotspot_y: 0;
    in-out property <int> studio_img_w: 32;
    in-out property <int> studio_img_h: 32;
    in-out property <image> studio_preview;
    in-out property <bool> studio_has_preview: false;
    in-out property <string> studio_selected_role: "left_ptr";
    in-out property <[StudioRole]> studio_roles: [];
    in-out property <string> import_note: "Drop a zip, tar.gz, tar.xz, or an unpacked theme folder.";
    in-out property <string> app_version: "0.1.0";
    in-out property <string> update_note: "";
    in-out property <bool> update_available: false;
    in-out property <string> update_tag: "";

    in-out property <bool> auth_signed_in: false;
    in-out property <bool> auth_creating: false;
    in-out property <bool> auth_busy: false;
    in-out property <string> auth_name: "";
    in-out property <string> auth_username: "";
    in-out property <string> auth_email: "";
    in-out property <string> auth_password: "";
    in-out property <string> auth_confirm: "";
    in-out property <string> auth_session_email: "";
    in-out property <string> auth_session_name: "";
    in-out property <string> auth_session_username: "";
    in-out property <string> auth_joined: "";
    in-out property <string> auth_published_label: "";
    in-out property <image> auth_avatar;
    in-out property <bool> auth_has_avatar: false;
    in-out property <string> auth_error: "";
    in-out property <string> device_os: "";
    in-out property <string> device_desktop: "";
    in-out property <string> device_session: "";
    in-out property <string> device_kernel: "";
    in-out property <string> device_cursor: "";
    in-out property <string> device_gtk: "";
    in-out property <string> device_qt: "";
    in-out property <string> device_env: "";

    callback apply_theme(string, int);
    callback import_theme_dialog();
    callback import_folder_dialog();
    callback import_dropped(data-transfer);
    callback studio_file_dropped(data-transfer);
    callback delete_theme(string);
    callback refresh_themes();
    callback search_changed(string);
    callback size_changed(int);
    callback page_changed(int);
    callback filter_changed();
    callback settings_changed();
    callback hypr_prefs_changed();
    callback studio_pick_image();
    callback studio_select_role(string);
    callback studio_set_hotspot(float, float);
    callback studio_use_for_all();
    callback studio_export();
    callback open_themes_folder();
    callback check_for_update();
    callback apply_update();
    callback dismiss_update();
    callback copy_device_info();
    callback refresh_device_info();
    callback open_support();
    callback open_x();
    callback open_contribute();
    callback sign_in();
    callback create_account();
    callback sign_out();
    callback open_forgot_password();
    callback open_account_page();

    function go(p: int) {
        root.page = p;
        root.page_changed(p);
    }

    function submit-auth() {
        if root.auth_creating {
            root.create_account();
        } else {
            root.sign_in();
        }
    }

    property <string> page-title: root.page == 0 ? "Library"
        : root.page == 1 ? "Import"
        : root.page == 2 ? "Studio"
        : root.page == 3 ? "About"
        : root.page == 4 ? (root.auth_signed_in ? "Profile" : (root.auth_creating ? "Create account" : "Sign in"))
        : "Settings";
    property <string> page-sub: root.page == 0 ? "Every pointer installed on this machine."
        : root.page == 1 ? "Install a pack from an archive or a folder."
        : root.page == 2 ? "Build an XCursor theme from PNG frames."
        : root.page == 3 ? "What Mouse Me is, and where it lives on disk."
        : root.page == 4 ? (root.auth_signed_in ? (root.auth_session_username != "" ? "@" + root.auth_session_username : "Your Mouse Me account.") : (root.auth_creating ? "This is the same account as the Mouse Me website." : "Use the email and password from the Mouse Me website."))
        : "Where the pointer is applied, and how it behaves.";
    property <string> sidebar-user-label: !root.auth_signed_in ? "User"
        : (root.auth_session_name != "" ? root.auth_session_name : (root.auth_session_username != "" ? root.auth_session_username : "User"));

    HorizontalLayout {
        padding: 16px;
        spacing: 14px;

        // Floating sidebar
        Rectangle {
            width: 88px;
            border-radius: 28px;
            background: Ink.sidebar;
            border-width: 1px;
            border-color: Ink.stroke;

            VerticalLayout {
                width: 100%;
                height: 100%;
                padding-top: 16px;
                padding-bottom: 14px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 20px;
                        clip: true;
                        background: Ink.parchment;

                        Image {
                            source: @image-url("../assets/mouse-me.png");
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }
                    }
                }

                Display {
                    text: "Mouse\nMe";
                    font-size: 11px;
                    font-weight: 700;
                    color: Ink.parchment;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 8px;
                    background: transparent;
                }

                NavBtn {
                    icon: @image-url("../assets/icons/house.svg");
                    label: "Library";
                    active: root.page == 0;
                    clicked => { root.go(0); }
                }

                NavBtn {
                    icon: @image-url("../assets/icons/download-simple.svg");
                    label: "Import";
                    active: root.page == 1;
                    clicked => { root.go(1); }
                }

                NavBtn {
                    icon: @image-url("../assets/icons/avocado.svg");
                    label: "Studio";
                    active: root.page == 2;
                    clicked => { root.go(2); }
                }

                NavBtn {
                    icon: @image-url("../assets/icons/info.svg");
                    label: "About";
                    active: root.page == 3;
                    clicked => { root.go(3); }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                UserNav {
                    icon: @image-url("../assets/icons/user.svg");
                    label: root.sidebar-user-label;
                    signed-in: root.auth_signed_in;
                    has-photo: root.auth_has_avatar;
                    photo: root.auth_avatar;
                    active: root.page == 4;
                    clicked => { root.go(4); }
                }

                NavBtn {
                    icon: @image-url("../assets/icons/gear.svg");
                    label: "Settings";
                    active: root.page == 5;
                    clicked => { root.go(5); }
                }
            }
        }

        // Main stage
        Rectangle {
            border-radius: 28px;
            background: Ink.panel;
            border-width: 1px;
            border-color: Ink.stroke;
            clip: true;
            horizontal-stretch: 1;

            VerticalLayout {
                width: 100%;
                height: 100%;
                padding: 22px;
                spacing: 16px;

                // Header
                HorizontalLayout {
                    spacing: 16px;

                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        horizontal-stretch: 1;
                        Display {
                            text: root.page-title;
                            font-size: 26px;
                            font-weight: 700;
                            color: Ink.ivory;
                        }

                        Text {
                            text: root.page-sub;
                            font-size: 13px;
                            color: Ink.mist;
                        }
                    }

                    if root.page != 4: VerticalLayout {
                        alignment: center;
                        FillBtn {
                            label: "Refresh";
                            quiet: true;
                            with-icon: true;
                            icon: @image-url("../assets/icons/arrow-clockwise.svg");
                            busy: root.is_loading;
                            clicked => { root.refresh_themes(); }
                        }
                    }
                }

                if root.page == 0: library := VerticalLayout {
                    spacing: 14px;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        Field {
                            width: 260px;
                            placeholder: "Filter by name…";
                            value: root.search_query;
                            edited(t) => { root.search_changed(t); }
                        }

                        Chip {
                            label: "All";
                            active: root.library_filter == "all";
                            clicked => { root.library_filter = "all"; root.filter_changed(); }
                        }

                        Chip {
                            label: "User";
                            active: root.library_filter == "user";
                            clicked => { root.library_filter = "user"; root.filter_changed(); }
                        }

                        Chip {
                            label: "System";
                            active: root.library_filter == "system";
                            clicked => { root.library_filter = "system"; root.filter_changed(); }
                        }

                        Rectangle {
                            width: 8px;
                            height: 36px;
                            background: transparent;
                        }

                        Chip {
                            label: "Any format";
                            active: root.library_type == "all";
                            clicked => { root.library_type = "all"; root.filter_changed(); }
                        }

                        Chip {
                            label: "XCursor";
                            active: root.library_type == "xcursor";
                            clicked => { root.library_type = "xcursor"; root.filter_changed(); }
                        }

                        Chip {
                            label: "Hyprcursor";
                            active: root.library_type == "hyprcursor";
                            clicked => { root.library_type = "hyprcursor"; root.filter_changed(); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            background: transparent;
                        }

                        Text {
                            text: root.theme_count + " packs";
                            font-size: 12px;
                            color: Ink.mist;
                            vertical-alignment: center;
                            height: 100%;
                        }
                    }

                    HorizontalLayout {
                        height: 36px;
                        spacing: 6px;
                        Text {
                            text: "Size";
                            font-size: 11px;
                            color: Ink.mist;
                            vertical-alignment: center;
                            height: 100%;
                        }

                        SizePill {
                            px: 16;
                            active: root.active_size == 16;
                            clicked => { root.size_changed(16); }
                        }

                        SizePill {
                            px: 24;
                            active: root.active_size == 24;
                            clicked => { root.size_changed(24); }
                        }

                        SizePill {
                            px: 32;
                            active: root.active_size == 32;
                            clicked => { root.size_changed(32); }
                        }

                        SizePill {
                            px: 48;
                            active: root.active_size == 48;
                            clicked => { root.size_changed(48); }
                        }

                        SizePill {
                            px: 64;
                            active: root.active_size == 64;
                            clicked => { root.size_changed(64); }
                        }
                    }

                    if root.theme_count == 0: Rectangle {
                        vertical-stretch: 1;
                        border-radius: 20px;
                        background: Ink.well;
                        border-width: 1px;
                        border-color: Ink.stroke;

                        VerticalLayout {
                            alignment: center;
                            spacing: 10px;
                            Display {
                                text: "Nothing on the desk yet";
                                font-size: 16px;
                                font-weight: 700;
                                color: Ink.ivory;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Import a zip from the Import page, or cut a pointer in Studio.";
                                font-size: 13px;
                                color: Ink.mist;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                FillBtn {
                                    label: "Import a pack";
                                    clicked => { root.go(1); }
                                }

                                FillBtn {
                                    label: "Open Studio";
                                    quiet: true;
                                    clicked => { root.go(2); }
                                }
                            }
                        }
                    }

                    if root.theme_count > 0: ScrollView {
                        vertical-stretch: 1;
                        viewport-y <=> root.library_viewport_y;
                        changed visible-height => {
                            root.library_visible_height = self.visible-height;
                        }
                        VerticalLayout {
                            spacing: 10px;
                            padding-right: 8px;

                            for item in root.themes: Rectangle {
                                height: 92px;
                                border-radius: 18px;
                                border-width: 1px;
                                border-color: item.is_active ? Ink.sage : Ink.stroke;
                                background: item.is_active ? #1E4F3428 : Ink.well;

                                HorizontalLayout {
                                    width: 100%;
                                    height: 100%;
                                    padding: 12px;
                                    spacing: 14px;

                                    Rectangle {
                                        width: 176px;
                                        vertical-stretch: 1;
                                        border-radius: 14px;
                                        background: Ink.parchment;
                                        clip: true;

                                        VerticalLayout {
                                            width: 100%;
                                            height: 100%;
                                            alignment: center;

                                            if item.has_preview: HorizontalLayout {
                                                alignment: center;
                                                spacing: 8px;
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                PreviewSlot {
                                                    frame: item.preview_default;
                                                }

                                                PreviewSlot {
                                                    frame: item.preview_pointer;
                                                }

                                                PreviewSlot {
                                                    frame: item.preview_wait;
                                                }

                                                PreviewSlot {
                                                    frame: item.preview_text;
                                                }
                                            }
                                            if !item.has_preview: Text {
                                                height: 32px;
                                                text: "No preview";
                                                font-size: 11px;
                                                color: #5C6B52;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 5px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        vertical-stretch: 1;

                                        Display {
                                            text: item.display_name;
                                            font-size: 15px;
                                            font-weight: 700;
                                            color: Ink.ivory;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: item.comment != "" ? item.comment : item.path;
                                            font-size: 11px;
                                            color: Ink.mist;
                                            overflow: elide;
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Tag {
                                                label: item.cursor_type;
                                                fill: item.cursor_type == "Hyprcursor" ? #1E4F3455 : Ink.ghost;
                                                ink: item.cursor_type == "Hyprcursor" ? Ink.sage : Ink.fog;
                                            }

                                            if item.is_user: Tag {
                                                label: "User";
                                            }

                                            if item.is_active: Tag {
                                                label: "Live";
                                                fill: #C9845A33;
                                                ink: Ink.click;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        vertical-stretch: 1;
                                        HorizontalLayout {
                                            spacing: 8px;

                                            if item.is_deletable: FillBtn {
                                                label: "Remove";
                                                quiet: true;
                                                danger: true;
                                                clicked => { root.delete_theme(item.name); }
                                            }

                                            FillBtn {
                                                label: item.is_active ? "Applied" : "Apply";
                                                quiet: item.is_active;
                                                clicked => {
                                                    if !item.is_active {
                                                        root.apply_theme(item.name, root.active_size);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.page == 1: VerticalLayout {
                    spacing: 16px;
                    vertical-stretch: 1;

                    drop_zone := DropArea {
                        vertical-stretch: 1;
                        min-height: 280px;
                        can-drop(event) => {
                            return DragAction.copy;
                        }
                        dropped(event) => {
                            root.import_dropped(event.data);
                            return DragAction.copy;
                        }

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 24px;
                            border-width: 1.5px;
                            border-color: drop_zone.has-drag ? Ink.sage : Ink.stroke-strong;
                            background: drop_zone.has-drag ? #6B946822 : Ink.well;

                            VerticalLayout {
                                width: 100%;
                                height: 100%;
                                alignment: center;
                                spacing: 12px;
                                padding: 32px;

                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 72px;
                                        height: 72px;
                                        border-radius: 22px;
                                        clip: true;
                                        background: Ink.parchment;
                                        Image {
                                            source: @image-url("../assets/mouse-me.png");
                                            width: 100%;
                                            height: 100%;
                                            image-fit: cover;
                                        }
                                    }
                                }

                                Display {
                                    text: drop_zone.has-drag ? "Release to install" : "Drop a cursor pack here";
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: Ink.ivory;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.import_note;
                                    font-size: 13px;
                                    color: Ink.mist;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 10px;
                                    FillBtn {
                                        label: "Browse archive";
                                        clicked => { root.import_theme_dialog(); }
                                    }

                                    FillBtn {
                                        label: "Browse folder";
                                        quiet: true;
                                        clicked => { root.import_folder_dialog(); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.page == 2: HorizontalLayout {
                    spacing: 14px;
                    vertical-stretch: 1;

                    Rectangle {
                        width: 200px;
                        border-radius: 18px;
                        background: Ink.well;
                        border-width: 1px;
                        border-color: Ink.stroke;

                        VerticalLayout {
                            width: 100%;
                            height: 100%;
                            padding: 12px;
                            spacing: 6px;
                            Display {
                                text: "Roles";
                                font-size: 11px;
                                font-weight: 700;
                                color: Ink.mist;
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 4px;
                                    for role in root.studio_roles: Rectangle {
                                        height: 34px;
                                        border-radius: 10px;
                                        background: role.id == root.studio_selected_role ? #1E4F3455 : (rtouch.has-hover ? Ink.ghost : #00000000);

                                        HorizontalLayout {
                                            width: 100%;
                                            height: 100%;
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                vertical-stretch: 1;
                                                Rectangle {
                                                    width: 7px;
                                                    height: 7px;
                                                    border-radius: 4px;
                                                    background: role.assigned ? Ink.sage : Ink.stroke-strong;
                                                }
                                            }

                                            Text {
                                                text: role.label;
                                                font-size: 12px;
                                                font-weight: role.id == root.studio_selected_role ? 700 : 500;
                                                color: Ink.ivory;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                height: 100%;
                                            }
                                        }

                                        rtouch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.studio_select_role(role.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 18px;
                        background: Ink.well;
                        border-width: 1px;
                        border-color: Ink.stroke;

                        studio_drop := DropArea {
                            can-drop(event) => { return DragAction.copy; }
                            dropped(event) => {
                                root.studio_file_dropped(event.data);
                                return DragAction.copy;
                            }

                            VerticalLayout {
                                width: 100%;
                                height: 100%;
                                padding: 18px;
                                spacing: 12px;

                                Display {
                                    text: "Hotspot canvas  ·  click to set the tip";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Ink.mist;
                                }

                                Rectangle {
                                    vertical-stretch: 1;
                                    border-radius: 16px;
                                    background: Ink.parchment;
                                    clip: true;

                                    property <length> image-width: max(1, root.studio_img_w) * 1px;
                                    property <length> image-height: max(1, root.studio_img_h) * 1px;
                                    property <float> image-scale: min(self.width / image-width, self.height / image-height);
                                    property <length> displayed-width: image-width * image-scale;
                                    property <length> displayed-height: image-height * image-scale;
                                    property <length> image-left: (self.width - displayed-width) / 2;
                                    property <length> image-top: (self.height - displayed-height) / 2;

                                    if root.studio_has_preview: Image {
                                        source: root.studio_preview;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                    }
                                    if !root.studio_has_preview: VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        Display {
                                            text: studio_drop.has-drag ? "Drop PNG onto this role" : "No frame on this role";
                                            font-size: 14px;
                                            font-weight: 700;
                                            color: #4D5C46;
                                            horizontal-alignment: center;
                                        }

                                        Text {
                                            text: "Pick a PNG, or drop one here.";
                                            font-size: 12px;
                                            color: #6A7A62;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    if root.studio_has_preview: Rectangle {
                                        x: image-left + root.studio_hotspot_x * image-scale * 1px - 8px;
                                        y: image-top + root.studio_hotspot_y * image-scale * 1px - 8px;
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: Ink.click;
                                        background: #C9845A55;
                                    }

                                    canvas_touch := TouchArea {
                                        clicked => {
                                            if root.studio_has_preview {
                                                root.studio_set_hotspot(
                                                    max(0.0, min(1.0, (self.mouse-x - image-left) / max(1px, displayed-width))),
                                                    max(0.0, min(1.0, (self.mouse-y - image-top) / max(1px, displayed-height))));
                                            } else {
                                                root.studio_pick_image();
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    height: 36px;
                                    spacing: 8px;
                                    FillBtn {
                                        label: "Choose PNG";
                                        clicked => { root.studio_pick_image(); }
                                    }

                                    FillBtn {
                                        label: "Use on every role";
                                        quiet: true;
                                        clicked => { root.studio_use_for_all(); }
                                    }

                                    Text {
                                        text: "Hotspot  " + root.studio_hotspot_x + " × " + root.studio_hotspot_y;
                                        font-size: 11px;
                                        color: Ink.mist;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: right;
                                        height: 100%;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 250px;
                        border-radius: 18px;
                        background: Ink.well;
                        border-width: 1px;
                        border-color: Ink.stroke;

                        VerticalLayout {
                            width: 100%;
                            height: 100%;
                            padding: 16px;
                            spacing: 12px;

                            Display {
                                text: "Theme";
                                font-size: 11px;
                                font-weight: 700;
                                color: Ink.mist;
                            }

                            Field {
                                placeholder: "Name";
                                value <=> root.studio_name;
                            }

                            Field {
                                placeholder: "Comment (optional)";
                                value <=> root.studio_comment;
                            }

                            Display {
                                text: "Nominal size";
                                font-size: 11px;
                                font-weight: 700;
                                color: Ink.mist;
                            }

                            HorizontalLayout {
                                height: 36px;
                                spacing: 6px;
                                SizePill {
                                    px: 24;
                                    active: root.studio_size == 24;
                                    clicked => { root.studio_size = 24; }
                                }

                                SizePill {
                                    px: 32;
                                    active: root.studio_size == 32;
                                    clicked => { root.studio_size = 32; }
                                }

                                SizePill {
                                    px: 48;
                                    active: root.studio_size == 48;
                                    clicked => { root.studio_size = 48; }
                                }

                                SizePill {
                                    px: 64;
                                    active: root.studio_size == 64;
                                    clicked => { root.studio_size = 64; }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                background: transparent;
                            }

                            Text {
                                text: "Exports into ~/.local/share/icons as an XCursor pack, with aliases for GTK and X11.";
                                font-size: 11px;
                                color: Ink.mist;
                                wrap: word-wrap;
                            }

                            FillBtn {
                                label: "Export and install";
                                clicked => { root.studio_export(); }
                            }
                        }
                    }
                }

                if root.page == 3: VerticalLayout {
                    spacing: 16px;
                    vertical-stretch: 1;

                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 20px;
                        background: Ink.well;
                        border-width: 1px;
                        border-color: Ink.stroke;

                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                spacing: 28px;
                                padding: 32px;

                                // --- HERO SECTION ---
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 16px;

                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 80px;
                                            height: 80px;
                                            border-radius: 22px;
                                            clip: true;
                                            background: Ink.parchment;
                                            Image {
                                                source: @image-url("../assets/mouse-me.png");
                                                width: 100%;
                                                height: 100%;
                                                image-fit: cover;
                                            }
                                        }
                                    }

                                    Display {
                                        text: "Mouse Me";
                                        font-size: 22px;
                                        font-weight: 700;
                                        color: Ink.ivory;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: "Mouse Me is a cursor manager built for Linux desktops — Hyprland and Omarchy in particular — where the pointer still has to agree with GTK, Qt, and XWayland. It is a small app for a daily annoyance: keeping one theme in one place instead of five config files.";
                                        font-size: 13px;
                                        color: Ink.fog;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: "Choose a pack in the library and apply it. Mouse Me writes the theme and size into the live session, desktop settings, and your user environment so the rest of the system follows. Import an archive or a folder, or assemble a simple XCursor theme in Studio.";
                                        font-size: 13px;
                                        color: Ink.fog;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 12px;
                                        Text {
                                            text: "Version " + root.app_version;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Ink.parchment;
                                            vertical-alignment: center;
                                            height: 36px;
                                        }

                                        FillBtn {
                                            label: "Check for updates";
                                            quiet: true;
                                            busy: root.checking_update;
                                            clicked => { root.check_for_update(); }
                                        }
                                    }

                                    if root.update_available: VerticalLayout {
                                        spacing: 12px;
                                        Text {
                                            text: root.update_tag + " is available. Update Mouse Me on this computer?";
                                            font-size: 13px;
                                            color: Ink.ivory;
                                            horizontal-alignment: center;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 10px;
                                            FillBtn {
                                                label: "Update now";
                                                busy: root.checking_update;
                                                clicked => { root.apply_update(); }
                                            }
                                            FillBtn {
                                                label: "Not now";
                                                quiet: true;
                                                clicked => { root.dismiss_update(); }
                                            }
                                        }
                                    }

                                    if root.update_note != "": Text {
                                        text: root.update_note;
                                        font-size: 12px;
                                        color: Ink.mist;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 10px;
                                        FillBtn {
                                            label: "Buy me a coffee";
                                            with-icon: true;
                                            icon: @image-url("../assets/icons/coffee.svg");
                                            clicked => { root.open_support(); }
                                        }

                                        FillBtn {
                                            label: "Follow on X";
                                            quiet: true;
                                            with-icon: true;
                                            icon: @image-url("../assets/icons/x-logo.svg");
                                            clicked => { root.open_x(); }
                                        }

                                        FillBtn {
                                            label: "Contribute";
                                            quiet: true;
                                            with-icon: true;
                                            icon: @image-url("../assets/icons/github-logo.svg");
                                            clicked => { root.open_contribute(); }
                                        }
                                    }
                                }

                                // --- DIVIDER ---
                                Rectangle {
                                    height: 1px;
                                    background: Ink.stroke;
                                }

                                VerticalLayout {
                                    spacing: 14px;

                                    HorizontalLayout {
                                        spacing: 12px;

                                        VerticalLayout {
                                            spacing: 2px;
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Display {
                                                text: "This machine";
                                                font-size: 15px;
                                                font-weight: 700;
                                                color: Ink.ivory;
                                            }
                                            Text {
                                                text: "What Mouse Me sees for the session and the pointer.";
                                                font-size: 12px;
                                                color: Ink.mist;
                                                wrap: word-wrap;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: end;

                                            FillBtn {
                                                label: "Refresh";
                                                quiet: true;
                                                clicked => { root.refresh_device_info(); }
                                            }

                                            FillBtn {
                                                label: "Copy";
                                                quiet: true;
                                                clicked => { root.copy_device_info(); }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        border-radius: 16px;
                                        background: Ink.panel;
                                        border-width: 1px;
                                        border-color: Ink.stroke;

                                        HorizontalLayout {
                                            padding: 18px;
                                            spacing: 28px;

                                            VerticalLayout {
                                                spacing: 2px;
                                                horizontal-stretch: 1;
                                                Display {
                                                    text: "Session";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: Ink.mist;
                                                }
                                                DebugRow {
                                                    label: "OS";
                                                    value: root.device_os;
                                                }
                                                DebugRow {
                                                    label: "Desktop";
                                                    value: root.device_desktop;
                                                }
                                                DebugRow {
                                                    label: "Display";
                                                    value: root.device_session;
                                                }
                                                DebugRow {
                                                    label: "Kernel";
                                                    value: root.device_kernel;
                                                }
                                            }

                                            Rectangle {
                                                width: 1px;
                                                background: Ink.stroke;
                                            }

                                            VerticalLayout {
                                                spacing: 2px;
                                                horizontal-stretch: 1;
                                                Display {
                                                    text: "Pointer";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: Ink.mist;
                                                }
                                                DebugRow {
                                                    label: "Live";
                                                    value: root.device_cursor;
                                                }
                                                DebugRow {
                                                    label: "GTK";
                                                    value: root.device_gtk;
                                                }
                                                DebugRow {
                                                    label: "Qt";
                                                    value: root.device_qt;
                                                }
                                                DebugRow {
                                                    label: "Env";
                                                    value: root.device_env;
                                                }
                                                if root.device_cursor != "" && (root.device_gtk != root.device_cursor || root.device_qt != root.device_cursor): Text {
                                                    text: "GTK, Qt, and the live pointer are not the same.";
                                                    font-size: 11px;
                                                    color: Ink.click;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.page == 4: VerticalLayout {
                    spacing: 16px;
                    vertical-stretch: 1;

                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 20px;
                        background: Ink.well;
                        border-width: 1px;
                        border-color: Ink.stroke;

                        ScrollView {
                        VerticalLayout {
                            alignment: center;
                            padding: 32px;

                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    width: 360px;
                                    spacing: 16px;

                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 88px;
                                            height: 88px;
                                            border-radius: 44px;
                                            clip: true;
                                            background: Ink.ghost;

                                            if root.auth_signed_in && root.auth_has_avatar: Image {
                                                width: 100%;
                                                height: 100%;
                                                source: root.auth_avatar;
                                                image-fit: cover;
                                            }
                                            if !(root.auth_signed_in && root.auth_has_avatar): Image {
                                                x: 28px;
                                                y: 28px;
                                                width: 32px;
                                                height: 32px;
                                                source: @image-url("../assets/icons/user.svg");
                                                image-fit: contain;
                                                colorize: Ink.parchment;
                                            }
                                        }
                                    }

                                    if root.auth_signed_in: VerticalLayout {
                                        spacing: 16px;

                                        Display {
                                            text: root.auth_session_name != "" ? root.auth_session_name : root.auth_session_email;
                                            font-size: 18px;
                                            font-weight: 700;
                                            color: Ink.ivory;
                                            horizontal-alignment: center;
                                        }

                                        if root.auth_session_username != "": Text {
                                            text: "@" + root.auth_session_username;
                                            font-size: 13px;
                                            color: Ink.parchment;
                                            horizontal-alignment: center;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;

                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 14px;
                                                background: Ink.ghost;
                                                VerticalLayout {
                                                    padding: 14px;
                                                    spacing: 4px;
                                                    Display {
                                                        text: "Joined";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: Ink.mist;
                                                    }
                                                    Display {
                                                        text: root.auth_joined != "" ? root.auth_joined : "—";
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        color: Ink.ivory;
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 14px;
                                                background: Ink.ghost;
                                                VerticalLayout {
                                                    padding: 14px;
                                                    spacing: 4px;
                                                    Display {
                                                        text: "On the web";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: Ink.mist;
                                                    }
                                                    Display {
                                                        text: root.auth_published_label != "" ? root.auth_published_label : "None yet";
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        color: Ink.ivory;
                                                    }
                                                }
                                            }
                                        }

                                        FillBtn {
                                            label: "Sign out";
                                            quiet: true;
                                            clicked => { root.sign_out(); }
                                        }
                                    }

                                    if !root.auth_signed_in: VerticalLayout {
                                        spacing: 14px;

                                        if root.auth_creating: VerticalLayout {
                                            spacing: 4px;
                                            Display {
                                                text: "Name";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Ink.mist;
                                            }
                                            Field {
                                                placeholder: "Your name";
                                                value <=> root.auth_name;
                                                accepted => { root.submit-auth(); }
                                            }
                                        }

                                        if root.auth_creating: VerticalLayout {
                                            spacing: 4px;
                                            Display {
                                                text: "Username";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Ink.mist;
                                            }
                                            Field {
                                                placeholder: "your-name";
                                                value <=> root.auth_username;
                                                accepted => { root.submit-auth(); }
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 4px;
                                            Display {
                                                text: "Email";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Ink.mist;
                                            }
                                            Field {
                                                placeholder: "you@example.com";
                                                value <=> root.auth_email;
                                                accepted => { root.submit-auth(); }
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 4px;
                                            Display {
                                                text: "Password";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Ink.mist;
                                            }
                                            Field {
                                                secret: true;
                                                placeholder: "At least 8 characters";
                                                value <=> root.auth_password;
                                                accepted => { root.submit-auth(); }
                                            }
                                        }

                                        if root.auth_creating: VerticalLayout {
                                            spacing: 4px;
                                            Display {
                                                text: "Confirm password";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Ink.mist;
                                            }
                                            Field {
                                                secret: true;
                                                placeholder: "Repeat password";
                                                value <=> root.auth_confirm;
                                                accepted => { root.submit-auth(); }
                                            }
                                        }

                                        if root.auth_error != "": Text {
                                            text: root.auth_error;
                                            font-size: 12px;
                                            color: Ink.danger;
                                            wrap: word-wrap;
                                        }

                                        FillBtn {
                                            label: root.auth_creating ? "Create account" : "Sign in";
                                            busy: root.auth_busy;
                                            clicked => { root.submit-auth(); }
                                        }

                                        if !root.auth_creating: HorizontalLayout {
                                            alignment: center;
                                            forgot := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open_forgot_password(); }
                                                Text {
                                                    text: "Forgot password?";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: forgot.has-hover ? Ink.ivory : Ink.parchment;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text {
                                                text: root.auth_creating ? "Already have an account?" : "No account yet?";
                                                font-size: 12px;
                                                color: Ink.mist;
                                                vertical-alignment: center;
                                            }
                                            switcher := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.auth_creating = !root.auth_creating;
                                                    root.auth_error = "";
                                                    root.auth_confirm = "";
                                                }
                                                Text {
                                                    text: root.auth_creating ? "Sign in" : "Create one";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: switcher.has-hover ? Ink.ivory : Ink.parchment;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        }
                    }
                }

                if root.page == 5: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 14px;
                        padding-right: 8px;

                        Rectangle {
                            border-radius: 18px;
                            background: Ink.well;
                            border-width: 1px;
                            border-color: Ink.stroke;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 4px;
                                Display {
                                    text: "Mouse Me";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Ink.mist;
                                }

                                ToggleRow {
                                    title: "Auto-update";
                                    hint: "When a new release is published, install it according to the permission below.";
                                    checked <=> root.auto_update;
                                    toggled => { root.settings_changed(); }
                                }

                                HorizontalLayout {
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 16px;
                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Display {
                                            text: "When to install";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: root.auto_update ? Ink.ivory : Ink.mist;
                                        }
                                        Text {
                                            text: root.auto_update_when == 2 ? "Install as soon as an update is found, then restart."
                                                : (root.auto_update_when == 1 ? "Download and install quietly. Restart to start using it."
                                                : "Download now, install the next time you open Mouse Me.");
                                            font-size: 11px;
                                            color: Ink.mist;
                                            wrap: word-wrap;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        width: 200px;
                                        MenuSelect {
                                            selected <=> root.auto_update_when;
                                            enabled: root.auto_update;
                                            choices: ["On next launch", "In the background", "Instantly"];
                                            changed => { root.settings_changed(); }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 18px;
                            background: Ink.well;
                            border-width: 1px;
                            border-color: Ink.stroke;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 4px;
                                Display {
                                    text: "Pointer size";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Ink.mist;
                                }

                                HorizontalLayout {
                                    height: 36px;
                                    spacing: 6px;
                                    SizePill {
                                        px: 16;
                                        active: root.active_size == 16;
                                        clicked => { root.size_changed(16); }
                                    }

                                    SizePill {
                                        px: 24;
                                        active: root.active_size == 24;
                                        clicked => { root.size_changed(24); }
                                    }

                                    SizePill {
                                        px: 32;
                                        active: root.active_size == 32;
                                        clicked => { root.size_changed(32); }
                                    }

                                    SizePill {
                                        px: 48;
                                        active: root.active_size == 48;
                                        clicked => { root.size_changed(48); }
                                    }

                                    SizePill {
                                        px: 64;
                                        active: root.active_size == 64;
                                        clicked => { root.size_changed(64); }
                                    }
                                }

                                ToggleRow {
                                    title: "Apply size immediately";
                                    hint: "Changing a size pill writes it to the live session.";
                                    checked <=> root.apply_size_immediately;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "Apply imported packs";
                                    hint: "After a successful import, switch to the new theme.";
                                    checked <=> root.auto_apply_on_import;
                                    toggled => { root.settings_changed(); }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 18px;
                            background: Ink.well;
                            border-width: 1px;
                            border-color: Ink.stroke;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 2px;
                                Display {
                                    text: "Where it writes";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Ink.mist;
                                }

                                ToggleRow {
                                    title: "Hyprland";
                                    hint: "hyprctl setcursor for the live session.";
                                    checked <=> root.apply_hyprland;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "GSettings";
                                    hint: "org.gnome.desktop.interface cursor theme and size.";
                                    checked <=> root.apply_gsettings;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "GTK 2/3/4 configs";
                                    hint: "settings.ini and gtkrc-2.0.";
                                    checked <=> root.apply_gtk;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "Qt / KDE";
                                    hint: "kdeglobals Mouse section.";
                                    checked <=> root.apply_qt;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "User environment";
                                    hint: "environment.d with XCURSOR and HYPRCURSOR.";
                                    checked <=> root.apply_environment;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "X11 resources";
                                    hint: ".Xresources and xrdb merge.";
                                    checked <=> root.apply_xresources;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "Default index.theme";
                                    hint: "Inherits the chosen theme from ~/.icons/default.";
                                    checked <=> root.apply_default_index;
                                    toggled => { root.settings_changed(); }
                                }

                                ToggleRow {
                                    title: "Flatpak overrides";
                                    hint: "Expose icon directories to sandboxed apps.";
                                    checked <=> root.apply_flatpak;
                                    toggled => { root.settings_changed(); }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 18px;
                            background: Ink.well;
                            border-width: 1px;
                            border-color: Ink.stroke;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 2px;
                                Display {
                                    text: "Hyprland cursor";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Ink.mist;
                                }

                                ToggleRow {
                                    title: "Enable Hyprcursor";
                                    hint: "Prefer hyprcursor assets when a pack includes them.";
                                    checked <=> root.enable_hyprcursor;
                                    toggled => { root.hypr_prefs_changed(); }
                                }

                                ToggleRow {
                                    title: "Hide on key press";
                                    hint: "Conceal the pointer while typing.";
                                    checked <=> root.hide_on_key_press;
                                    toggled => { root.hypr_prefs_changed(); }
                                }

                                ToggleRow {
                                    title: "Hide on touch";
                                    hint: "Conceal the pointer during touch input.";
                                    checked <=> root.hide_on_touch;
                                    toggled => { root.hypr_prefs_changed(); }
                                }

                                ToggleRow {
                                    title: "No hardware cursors";
                                    hint: "Force software rendering for the pointer.";
                                    checked <=> root.no_hardware_cursors;
                                    toggled => { root.hypr_prefs_changed(); }
                                }

                                HorizontalLayout {
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 14px;
                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Display {
                                            text: "Inactive timeout";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Ink.ivory;
                                        }

                                        Text {
                                            text: root.inactive_timeout == 0 ? "Stay visible" : root.inactive_timeout + " seconds until hide";
                                            font-size: 11px;
                                            color: Ink.mist;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Chip {
                                                label: "Off";
                                                active: root.inactive_timeout == 0;
                                                clicked => { root.inactive_timeout = 0; root.hypr_prefs_changed(); }
                                            }

                                            Chip {
                                                label: "3s";
                                                active: root.inactive_timeout == 3;
                                                clicked => { root.inactive_timeout = 3; root.hypr_prefs_changed(); }
                                            }

                                            Chip {
                                                label: "5s";
                                                active: root.inactive_timeout == 5;
                                                clicked => { root.inactive_timeout = 5; root.hypr_prefs_changed(); }
                                            }

                                            Chip {
                                                label: "10s";
                                                active: root.inactive_timeout == 10;
                                                clicked => { root.inactive_timeout = 10; root.hypr_prefs_changed(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 18px;
                            background: Ink.well;
                            border-width: 1px;
                            border-color: Ink.stroke;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 2px;
                                Display {
                                    text: "Library";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Ink.mist;
                                }

                                ToggleRow {
                                    title: "Show user packs";
                                    hint: "Themes installed under your home directory.";
                                    checked <=> root.show_user_themes;
                                    toggled => { root.filter_changed(); }
                                }

                                ToggleRow {
                                    title: "Show system packs";
                                    hint: "Themes from /usr/share/icons and friends.";
                                    checked <=> root.show_system_themes;
                                    toggled => { root.filter_changed(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
